---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechStackItem from '../components/TechStackItem.astro';
import CTASection from '../components/CTASection.astro';
import { Lightbulb, Layers, Zap } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 6);

const techStack = [
  { name: 'TypeScript & React', desc: locale === 'fr' ? 'Frontends typés et composants UI scalables pour applications modernes.' : 'Type-safe frontends and scalable UI components for modern applications.', icon: 'react' },
  { name: 'Astro & Tailwind', desc: locale === 'fr' ? 'Génération de sites statiques haute performance avec styling utilitaire rapide.' : 'High-performance static site generation with utility-first, rapid styling.', icon: 'astro' },
  { name: 'Firebase & Node.js', desc: locale === 'fr' ? 'Services backend robustes, bases de données temps réel et logique serverless.' : 'Robust backend services, real-time databases, and serverless logic.', icon: 'firebase' }
];

const manifesto = {
  heading: locale === 'fr' ? 'Ce qui me différencie' : 'What sets me apart',
  labels: locale === 'fr' ? ['Business first', 'Tout-en-un', 'Zéro ghosting'] : ['Business first', 'All-in-one', 'Zero ghosting'],
  paragraphs: locale === 'fr' ? [
    "Je comprends la logique business. Un site web n'est pas une œuvre d'art, c'est un outil qui doit générer du chiffre.",
    "Tout au même endroit. Je développe votre site ET je gère votre IT, pas besoin de jongler entre 5 prestataires.",
    "Zéro ghosting. Je réponds vite, je livre à temps, et je reste jusqu'à ce que ça tourne."
  ] : [
    "I understand business logic. A website isn't art, it's a tool that should drive revenue.",
    "Everything in one place. I build your site AND manage your IT, no need to juggle 5 freelancers.",
    "Zero ghosting. I reply fast, deliver on time, and stay until it works."
  ]
};

const experiences = [
  { 
    role: locale === 'fr' ? 'Alternant: Marketing/Business Analyst' : 'Intern: Marketing/Business Analyst',
    company: 'eTech Consulting',
    period: locale === 'fr' ? 'Sept 2025 — Mars 2026' : 'Sept 2025 — Mar 2026',
    tasks: locale === 'fr' ? [
      "Assistant de l'équipe commerciale locale et Offshore",
      "Compréhension fonctionnelle et technique des besoins du client",
      "Conception des propositions commerciales et des plaquettes",
      "Élaboration des offres et suivi des opportunités"
    ] : [
      "Assistant to local and Offshore commercial team",
      "Functional and technical understanding of client needs",
      "Design of commercial proposals and brochures",
      "Offer development and opportunity tracking"
    ]
  },
  { 
    role: 'Développeur React',
    company: 'Malitix (eTech Consulting)',
    period: locale === 'fr' ? 'Sept 2025 — Mars 2026' : 'Sept 2025 — Mar 2026',
    tasks: locale === 'fr' ? [
      "Création intégrale d'une plateforme web dédiée à l'acquisition de clients offshore",
      "Développement frontend React et intégration API",
      "Conception de l'architecture technique et déploiement"
    ] : [
      "End-to-end creation of a web platform for offshore client acquisition",
      "React frontend development and API integration",
      "Technical architecture design and deployment"
    ],
    link: 'https://malitix.com'
  },
  { 
    role: locale === 'fr' ? 'Consultant IT' : 'IT Consultant',
    company: 'Exotika.mg',
    period: locale === 'fr' ? '2026 — Présent' : '2026 — Present',
    tasks: locale === 'fr' ? [
      "Migration du site statique vers une plateforme ecommerce",
      "Intégration de l'ERP Odoo pour la gestion des stocks et commandes",
      "Gestion technique et optimisation des performances"
    ] : [
      "Migration from static site to ecommerce platform",
      "Odoo ERP integration for inventory and order management",
      "Technical management and performance optimization"
    ],
    link: 'https://exotika.mg'
  },
  { 
    role: locale === 'fr' ? 'Développeur React & Javascript' : 'React & JavaScript Developer',
    company: 'Exotika.mg',
    period: locale === 'fr' ? 'Juin 2025 — Juil 2025' : 'Jun 2025 — Jul 2025',
    tasks: locale === 'fr' ? [
      "Création complète du site internet pour une boutique de vape",
      "Déploiement sur Firebase avec intégration CMS Contentful"
    ] : [
      "Complete website creation for a vape shop",
      "Firebase deployment with Contentful CMS integration"
    ],
    link: 'https://exotika.mg'
  },
  { 
    role: 'Community Manager',
    company: "L'Art Blanc",
    period: locale === 'fr' ? 'Juil 2024 — Jan 2026' : 'Jul 2024 — Jan 2026',
    tasks: locale === 'fr' ? [
      "Création et publication de contenu digital",
      "Réalisation des éléments graphiques",
      "Élaboration des campagnes publicitaires"
    ] : [
      "Digital content creation and publishing",
      "Graphic design production",
      "Advertising campaign development"
    ]
  },
];
---

<Layout>
  <main class="bg-primary-dark text-white min-h-screen">
    
    <Hero 
      name="Nikita Nirinovich"
      headline={t('hero.headline')}
      resumeLabel={t('nav.resume')}
      githubLabel="GitHub"
      workLabel={t('nav.work')}
      projectsLabel={t('nav.projects')}
      langSwitchLabel={t('language.switch')}
      langSwitchHref={locale === 'fr' ? '/en' : '/'}
    />

    <!-- Accent spacer -->
    <div class="h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

    <!-- Manifesto -->
    <div class="border-b-2 border-slate-800 px-8 py-12 sm:px-16">
      <h2 class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl font-heading mb-10">
        {manifesto.heading}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {manifesto.paragraphs.map((p, i) => (
          <div class="bg-slate-800 p-6 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              {i === 0 && <Lightbulb class="w-5 h-5 text-accent" />}
              {i === 1 && <Layers class="w-5 h-5 text-accent" />}
              {i === 2 && <Zap class="w-5 h-5 text-accent" />}
              <span class="text-accent font-mono text-xs uppercase tracking-widest">{manifesto.labels[i]}</span>
            </div>
            <p class="text-slate-400 text-base leading-relaxed">{p}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Featured Projects Section -->
    <div id="featured">
      <SectionHeader 
        title={t('section.featured.title')}
        emphasis={locale === 'fr' ? 'Sélectionnés' : 'Featured'}
      />
    </div>
    
    <!-- Compact Cards -->
    <div class="border-b-2 border-slate-800">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-slate-800">
        {featuredProjects.map(project => (
          <a href={`/projects/${project.id}`} class="bg-primary-dark group flex flex-col overflow-hidden hover:bg-slate-900 transition-all">
            <div class="relative aspect-[1200/630] w-full overflow-hidden">
              <img src={project.data.thumbnail} alt={project.data.title} class="absolute inset-0 w-full h-full object-cover transition-all duration-500 group-hover:scale-110 filter grayscale group-hover:grayscale-0 group-hover:opacity-90" />
            </div>
            <div class="p-3 flex flex-col gap-1">
              <h3 class="text-sm font-bold font-heading leading-tight group-hover:text-accent transition-colors">{project.data.title}</h3>
              <span class="text-[10px] font-mono text-accent">{project.data.date.getFullYear()}</span>
              <div class="flex flex-wrap gap-1 mt-1">
                {(project.data.techStack || []).slice(0, 2).map(tech => (
                  <span class="text-[8px] font-mono uppercase tracking-widest text-slate-600">{tech}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
        <!-- Placeholder card -->
        <div class="bg-primary-dark flex flex-col overflow-hidden border-2 border-dashed border-slate-700">
          <div class="relative aspect-[1200/630] w-full flex items-center justify-center bg-slate-900">
            <svg class="w-12 h-12 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </div>
          <div class="p-3 flex flex-col gap-1">
            <h3 class="text-sm font-bold font-heading leading-tight text-slate-600">{locale === 'fr' ? 'Prochain projet' : 'Next project'}</h3>
            <span class="text-[10px] font-mono text-slate-700">{locale === 'fr' ? 'Bientôt' : 'Coming soon'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- View All Projects Button -->
    <div class="px-8 py-8 sm:px-16 border-b-2 border-slate-800">
      <a href="/projects" class="inline-flex items-center gap-2 bg-accent text-white font-bold uppercase text-sm px-6 py-3 hover:bg-accent/80 transition-colors">
        {t('featured.viewAll')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>

    <!-- Experiences Section -->
    <div id="experiences">
      <SectionHeader 
        title={t('section.experience.title')}
        emphasis={locale === 'fr' ? 'Expérience' : 'Experience'}
      />
    </div>

    <!-- Left/Right Timeline -->
    <div class="py-16 border-y-2 border-slate-800">
      <div class="max-w-5xl mx-auto px-8">
        <div class="relative">
          <div class="absolute left-1/2 top-0 bottom-0 w-px bg-slate-800 -translate-x-1/2"></div>
          
          {experiences.map((exp, i) => (
            <div class={`relative flex items-center pb-12 last:pb-0 experience-item ${i % 2 === 0 ? 'flex-row' : 'flex-row-reverse'}`} style={`--delay: ${i * 0.15}s`}>
              <div class="w-1/2 px-8">
                <div class={`${i % 2 === 0 ? 'text-right' : 'text-left'}`}>
                  <span class="text-xs font-mono text-accent uppercase tracking-wider">{exp.period}</span>
                  <h3 class="text-xl font-bold font-heading text-white mt-1">{exp.role}</h3>
                  <span class="text-sm text-slate-500 font-medium">{exp.company}</span>
                  <ul class={`mt-3 space-y-1.5 ${i % 2 === 0 ? 'ml-auto' : ''}`}>
                    {exp.tasks.map(task => (
                      <li class={`text-slate-400 text-sm leading-relaxed flex items-start gap-2 ${i % 2 === 0 ? 'justify-end' : ''}`}>
                        {i % 2 !== 0 && <span class="text-accent mt-1.5 text-[10px]">▸</span>}
                        <span>{task}</span>
                        {i % 2 === 0 && <span class="text-accent mt-1.5 text-[10px]">◂</span>}
                      </li>
                    ))}
                  </ul>
                  {exp.link && (
                    <a href={exp.link} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-1.5 mt-3 text-xs font-mono text-accent hover:text-white transition-colors ${i % 2 === 0 ? 'ml-auto' : ''}`}>
                      <span>{exp.link.replace('https://', '')}</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                  )}
                </div>
              </div>
              
              <div class="relative z-10 flex-shrink-0">
                <div class="w-8 h-8 rounded-full bg-slate-900 border-2 border-slate-800 flex items-center justify-center group-hover:border-accent transition-colors">
                  <div class="w-2 h-2 rounded-full bg-slate-600 group-hover:bg-accent transition-colors"></div>
                </div>
              </div>
              
              <div class="w-1/2 px-8"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- The Arsenal -->
    <SectionHeader 
      title={t('section.arsenal.title')}
      emphasis={locale === 'fr' ? 'Arsenal' : 'Arsenal'}
    />

    <div class="flex flex-col border-y-2 border-slate-800">
      {techStack.map((item, i) => (
        <TechStackItem 
          number={i + 1}
          name={item.name}
          description={item.desc}
          icon={item.icon}
        />
      ))}
    </div>
    
    <CTASection 
      message={t('cta.message')}
      emailLabel={t('cta.emailLabel')}
    />

  </main>
</Layout>

<script>
  // Scroll reveal for experience items
  const observerOptions = {
    threshold: 0.15,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.experience-item').forEach(item => {
    observer.observe(item);
  });
</script>

<style>
  .experience-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--delay, 0s);
  }

  .experience-item.revealed {
    opacity: 1;
    transform: translateX(0);
  }
</style>
