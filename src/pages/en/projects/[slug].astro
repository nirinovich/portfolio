---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/translations';
import { getCollection, render } from 'astro:content';

const locale = (Astro.currentLocale ?? 'en') as 'fr' | 'en';
const t = useTranslations(locale);

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const prefix = locale === 'en' ? '/en' : '';
---

<Layout title={`${project.data.title} — Nikita Nirinovich`}>
  <main class="min-h-screen bg-[#e8ecf1] pt-24 pb-16 px-8">
    <div class="max-w-3xl mx-auto">
      <!-- Back link -->
      <a href={prefix + '/#projects'} class="inline-flex items-center gap-2 text-[#718096] hover:text-[#2d3748] transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        {t('project.back')}
      </a>

      <!-- Header -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">
        <div class="aspect-video bg-[#dde3ec] overflow-hidden">
          <img src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-cover" />
        </div>
        <div class="p-8">
          <h1 class="text-3xl md:text-4xl font-bold text-[#2d3748]">{project.data.title}</h1>
          <p class="text-[#718096] mt-3 text-lg">{project.data.description}</p>
          
          <div class="flex flex-wrap gap-2 mt-4">
            {project.data.techStack.map(tech => (
              <span class="text-sm px-3 py-1 bg-[#dde3ec] text-[#4a5568] rounded-full">{tech}</span>
            ))}
          </div>

          <div class="flex flex-wrap gap-2 mt-3">
            {project.data.tags.map(tag => (
              <span class="text-sm px-3 py-1 bg-[#2d3748]/10 text-[#2d3748] rounded-full">#{tag}</span>
            ))}
          </div>

          {project.data.links && (
            <div class="flex gap-4 mt-6">
              {project.data.links.github && (
                <a href={project.data.links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-[#2d3748] text-white rounded-lg hover:bg-[#4a5568] transition-colors text-sm">
                  {t('project.links.github')}
                </a>
              )}
              {project.data.links.live && (
                <a href={project.data.links.live} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 border border-[#2d3748] text-[#2d3748] rounded-lg hover:bg-[#2d3748] hover:text-white transition-colors text-sm">
                  {t('project.links.live')}
                </a>
              )}
            </div>
          )}
        </div>
      </div>

      {project.data.gallery && project.data.gallery.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-[#2d3748] mb-4">{t('project.gallery')}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {project.data.gallery.map(img => (
              <div class="rounded-xl overflow-hidden shadow-md">
                <img src={img} alt="" class="w-full h-full object-cover" />
              </div>
            ))}
          </div>
        </div>
      )}

      <article class="prose prose-lg max-w-none bg-white rounded-2xl shadow-md p-8">
        <Content />
      </article>
    </div>
  </main>
</Layout>
