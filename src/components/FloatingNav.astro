---
import { useTranslations, type Locale } from '../i18n/translations';

const locale = (Astro.currentLocale ?? 'fr') as Locale;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const basePath = currentPath.replace(/^\/en(\/|$)/, '/');
const prefix = locale === 'en' ? '/en' : '';

const langSwitchHref = locale === 'en'
  ? basePath
  : `/en${basePath === '/' ? '' : basePath}`;

const pages = [
  { href: prefix + '/', key: 'nav.home' as const },
  { href: prefix + '/about', key: 'nav.about' as const },
  { href: prefix + '/blog', key: 'nav.blog' as const },
  { href: prefix + '/games', key: 'nav.games' as const },
  { href: prefix + '/contact', key: 'nav.contact' as const },
];
---

<!-- Option A: Corner FAB -->
<div id="nav-fab" class="nav-variant fixed bottom-6 right-6 z-50">
  <div class="relative">
    <!-- Expanded menu -->
    <div id="fab-menu" class="hidden absolute bottom-16 right-0 flex flex-col items-end gap-2 mb-2">
      {pages.map(page => (
        <a href={page.href} class="flex items-center gap-2 bg-white/90 backdrop-blur-md text-[#4a5568] hover:text-[#2d3748] px-4 py-2 rounded-full shadow-md hover:shadow-lg transition-all text-sm whitespace-nowrap">
          {t(page.key)}
        </a>
      ))}
      <a href={langSwitchHref} class="flex items-center gap-2 bg-white/90 backdrop-blur-md text-[#4a5568] hover:text-[#2d3748] px-4 py-2 rounded-full shadow-md hover:shadow-lg transition-all text-sm whitespace-nowrap">
        {t('language.switch')}
      </a>
      <a href="/resume.pdf" target="_blank" class="flex items-center gap-2 bg-white/90 backdrop-blur-md text-[#4a5568] hover:text-[#2d3748] px-4 py-2 rounded-full shadow-md hover:shadow-lg transition-all text-sm whitespace-nowrap">
        {t('nav.resume')}
      </a>
    </div>
    <!-- FAB button -->
    <button id="fab-toggle" class="w-14 h-14 bg-[#2d3748] text-white rounded-full shadow-lg hover:shadow-xl hover:bg-[#4a5568] transition-all flex items-center justify-center">
      <svg class="w-6 h-6 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</div>

<!-- Option B: Side Rail -->
<div id="nav-rail" class="nav-variant fixed left-0 top-1/2 -translate-y-1/2 z-50 hidden">
  <div class="bg-white/80 backdrop-blur-md rounded-r-2xl shadow-lg py-4 px-2 flex flex-col items-center gap-3">
    {pages.map(page => (
      <a href={page.href} class="group relative w-10 h-10 flex items-center justify-center text-[#718096] hover:text-[#2d3748] hover:bg-[#dde3ec] rounded-xl transition-all" title={t(page.key)}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="absolute left-12 bg-[#2d3748] text-white text-xs px-2 py-1 rounded-md opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
          {t(page.key)}
        </span>
      </a>
    ))}
    <div class="w-6 border-t border-[#dde3ec] my-1"></div>
    <a href={langSwitchHref} class="w-10 h-10 flex items-center justify-center text-[#718096] hover:text-[#2d3748] hover:bg-[#dde3ec] rounded-xl transition-all text-xs font-bold" title={t('language.switch')}>
      {locale === 'fr' ? 'EN' : 'FR'}
    </a>
    <a href="/resume.pdf" target="_blank" class="w-10 h-10 flex items-center justify-center text-[#718096] hover:text-[#2d3748] hover:bg-[#dde3ec] rounded-xl transition-all" title={t('nav.resume')}>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </a>
  </div>
</div>

<!-- Option C: Full-screen Overlay -->
<div id="nav-overlay" class="nav-variant hidden">
  <!-- Trigger -->
  <button id="overlay-toggle" class="fixed top-4 right-4 z-50 w-12 h-12 bg-[#2d3748]/80 backdrop-blur-md text-white rounded-full shadow-lg hover:shadow-xl hover:bg-[#2d3748] transition-all flex items-center justify-center">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
  <!-- Overlay -->
  <div id="overlay-menu" class="hidden fixed inset-0 z-50 bg-[#e8ecf1]/95 backdrop-blur-lg flex flex-col items-center justify-center">
    <button id="overlay-close" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center text-[#4a5568] hover:text-[#2d3748] transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <nav class="flex flex-col items-center gap-6">
      {pages.map(page => (
        <a href={page.href} class="text-3xl md:text-4xl font-bold text-[#2d3748] hover:text-[#718096] transition-colors">
          {t(page.key)}
        </a>
      ))}
      <div class="flex items-center gap-4 mt-4">
        <a href="/resume.pdf" target="_blank" class="text-lg text-[#718096] hover:text-[#2d3748] transition-colors">
          {t('nav.resume')}
        </a>
        <span class="text-[#dde3ec]">|</span>
        <a href={langSwitchHref} class="text-lg text-[#718096] hover:text-[#2d3748] transition-colors">
          {t('language.switch')}
        </a>
      </div>
    </nav>
  </div>
</div>

<script>
  // FAB toggle
  const fabToggle = document.getElementById('fab-toggle');
  const fabMenu = document.getElementById('fab-menu');
  fabToggle?.addEventListener('click', () => {
    fabMenu?.classList.toggle('hidden');
    fabToggle.querySelector('svg')?.classList.toggle('rotate-45');
  });

  // Overlay toggle
  const overlayToggle = document.getElementById('overlay-toggle');
  const overlayMenu = document.getElementById('overlay-menu');
  const overlayClose = document.getElementById('overlay-close');
  overlayToggle?.addEventListener('click', () => overlayMenu?.classList.remove('hidden'));
  overlayClose?.addEventListener('click', () => overlayMenu?.classList.add('hidden'));
  overlayMenu?.addEventListener('click', (e) => {
    if (e.target === overlayMenu) overlayMenu.classList.add('hidden');
  });
</script>
