---
// Hero component - Two-column hero with profile image and inline nav
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  headline?: string;
  resumeLabel: string;
  githubLabel: string;
  workLabel?: string;
  projectsLabel?: string;
  profileImage?: string;
}

const { 
  name, 
  headline = 'I build websites and manage IT for SMEs',
  resumeLabel, 
  githubLabel, 
  workLabel = 'Work',
  projectsLabel = 'Projects',
  profileImage = '/profile.png' 
} = Astro.props;
---

<header id="hero" class="border-b-2 border-slate-800 min-h-[85vh] flex flex-col">
  <!-- Nav Variant A: In-hero nav, scrolls away -->
  <nav id="nav-a" class="flex items-center justify-between px-8 py-6 sm:px-16 lg:px-24">
    <a href="/" class="text-xl font-bold font-heading text-white">{name}</a>
    <div class="flex items-center gap-6">
      <a href="#featured" class="text-sm text-slate-400 hover:text-white transition-colors">{workLabel}</a>
      <a href="/resume.pdf" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors">{resumeLabel}</a>
      <a href="https://github.com/nirinovich" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
        <Icon name="mdi:github" class="w-4 h-4" /> {githubLabel}
      </a>
    </div>
  </nav>

  <!-- Hero content -->
  <div class="flex-1 grid w-full grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] items-stretch">
    <div class="flex flex-col justify-center gap-6 px-8 py-16 sm:px-16 sm:py-20 lg:pl-24">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-heading leading-[1.1] tracking-tight text-white max-w-xl">
        {headline}
      </h1>
      
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/resume.pdf" class="inline-flex items-center justify-center bg-white text-primary-dark px-6 py-3 font-bold uppercase tracking-wider text-sm hover:bg-slate-200 transition-colors">
          {resumeLabel}
        </a>
        <a href="https://github.com/nirinovich" target="_blank" class="inline-flex items-center justify-center border-2 border-slate-800 text-slate-300 px-6 py-3 font-bold uppercase tracking-wider text-sm hover:bg-slate-900 transition-colors gap-2">
          <Icon name="mdi:github" class="w-5 h-5" /> {githubLabel}
        </a>
      </div>
    </div>
    
    <div class="relative flex h-full w-full items-center justify-center bg-slate-900/50 border-t-2 md:border-t-0 md:border-l-2 border-slate-800 p-12">
      <div class="w-full max-w-sm aspect-[3/4] border-2 border-slate-800 bg-slate-900 p-2 transform rotate-3 hover:rotate-0 transition-transform duration-500">
         <img src={profileImage} alt={name} class="w-full h-full object-cover transition-all duration-700" />
      </div>
    </div>
  </div>
</header>
