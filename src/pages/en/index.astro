---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'en') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <!-- Hero Section -->
  <section id="hero" class="min-h-screen bg-[#e8ecf1] flex items-center justify-center px-8 relative">
    <div class="max-w-4xl w-full flex flex-col md:flex-row items-center md:items-start gap-12 md:gap-16">
      
      <!-- Profile Image Card -->
      <div class="flex-shrink-0">
        <div class="profile-card w-72 h-[22rem] bg-white rounded-2xl shadow-lg overflow-hidden" style="opacity: 0;">
          <img 
            src="/profile.png" 
            alt="Nikita Nirinovich" 
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h1 class="hero-name text-5xl md:text-6xl font-bold text-[#2d3748] tracking-tight" style="opacity: 0;">
          Nikita Nirinovich
        </h1>
        
        <p class="hero-subtitle text-xl md:text-2xl text-[#718096] mt-3 font-medium flex items-center gap-2" style="opacity: 0;">
          CS Student @
          <a href="https://esti.mg/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg px-3 py-1 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-105 transition-all">
            <img src="/logo-ESTI1-foot.svg" alt="ESTI" class="h-7 inline-block" />
          </a>
        </p>
        
        <p class="hero-p1 text-base md:text-lg text-[#4a5568] mt-6 max-w-lg leading-relaxed" style="opacity: 0;" set:html={t('hero.bio1')} />
        <p class="hero-p2 text-sm md:text-base text-[#718096] mt-3 max-w-lg leading-relaxed italic" style="opacity: 0;">
          {t('hero.bio2')}
        </p>

        <!-- Navigation Links -->
        <div class="flex items-center justify-between w-full mt-10">
          <nav class="flex items-center gap-3">
            <a href="#work" class="nav-link text-[#4a5568] hover:text-[#2d3748] text-base px-4 py-1.5 rounded-lg bg-[#dde3ec]/60 hover:bg-[#dde3ec] transition-all duration-200" style="opacity: 0;">
              {t('nav.work')}
            </a>
            <a href="#projects" class="nav-link text-[#4a5568] hover:text-[#2d3748] text-base px-4 py-1.5 rounded-lg bg-[#dde3ec]/60 hover:bg-[#dde3ec] transition-all duration-200" style="opacity: 0;">
              {t('nav.projects')}
            </a>
            <a href="/resume.pdf" target="_blank" class="nav-link text-[#4a5568] hover:text-[#2d3748] text-base px-4 py-1.5 rounded-lg bg-[#dde3ec]/60 hover:bg-[#dde3ec] transition-all duration-200" style="opacity: 0;">
              {t('nav.resume')}
            </a>
          </nav>

          <!-- Social Icons -->
          <div class="flex items-center gap-5">
            <a href="https://github.com/nirinovich" target="_blank" rel="noopener noreferrer" class="social-icon text-[#4a5568] hover:text-[#2d3748] transition-colors" style="opacity: 0;">
              <Icon name="mdi:github" class="w-6 h-6" />
            </a>
            <a href="https://www.linkedin.com/in/nirinovich/" target="_blank" rel="noopener noreferrer" class="social-icon text-[#4a5568] hover:text-[#2d3748] transition-colors" style="opacity: 0;">
              <Icon name="mdi:linkedin" class="w-6 h-6" />
            </a>
            <a href="mailto:nikita@nirinovich.com" class="social-icon text-[#4a5568] hover:text-[#2d3748] transition-colors" style="opacity: 0;">
              <Icon name="mdi:email" class="w-6 h-6" />
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
      <span class="text-xs text-[#718096]">{t('hero.scrollIndicator')}</span>
      <div class="scroll-indicator w-6 h-10 border-2 border-[#718096]/40 rounded-full flex items-start justify-center p-1.5">
        <div class="w-1.5 h-1.5 bg-[#718096]/60 rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Work Section -->
  <section id="work" class="scroll-reveal py-24 px-8 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-[#2d3748] mb-12 text-center">
        {t('section.work.title')}
      </h2>
      <div class="stagger-container relative">
        <!-- Timeline line -->
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-[#dde3ec] -translate-x-1/2"></div>
        
        <!-- Timeline items -->
        <div class="stagger-item relative flex flex-col md:flex-row items-start mb-12">
          <div class="md:w-1/2 md:pr-12 md:text-right pl-12 md:pl-0">
            <h3 class="text-xl font-semibold text-[#2d3748]">Web Developer</h3>
            <p class="text-[#718096] mt-1">Freelance</p>
          </div>
          <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-[#4a5568] rounded-full -translate-x-1/2 mt-1.5 border-2 border-white"></div>
          <div class="md:w-1/2 md:pl-12 pl-12">
            <span class="text-sm text-[#718096]">2024 — Present</span>
            <p class="text-[#4a5568] mt-2">Building web applications and personal projects for clients.</p>
          </div>
        </div>

        <div class="stagger-item relative flex flex-col md:flex-row items-start mb-12">
          <div class="md:w-1/2 md:pr-12 md:text-right pl-12 md:pl-0">
            <h3 class="text-xl font-semibold text-[#2d3748]">CS Student</h3>
            <p class="text-[#718096] mt-1">ESTI — Université de Fianarantsoa</p>
          </div>
          <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-[#4a5568] rounded-full -translate-x-1/2 mt-1.5 border-2 border-white"></div>
          <div class="md:w-1/2 md:pl-12 pl-12">
            <span class="text-sm text-[#718096]">2022 — Present</span>
            <p class="text-[#4a5568] mt-2">Studying computer science with a focus on web development and software engineering.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="scroll-reveal py-24 px-8 bg-[#e8ecf1]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-[#2d3748] mb-12 text-center">
        {t('section.projects.title')}
      </h2>
      <div class="stagger-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map(project => (
          <a href={`/en/projects/${project.id}`} class="stagger-item group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
            <div class="aspect-video bg-[#dde3ec] overflow-hidden">
              <img src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-semibold text-[#2d3748] group-hover:text-[#4a5568] transition-colors">{project.data.title}</h3>
              <p class="text-sm text-[#718096] mt-2 line-clamp-2">{project.data.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {project.data.techStack.slice(0, 4).map(tech => (
                  <span class="text-xs px-2 py-0.5 bg-[#dde3ec] text-[#4a5568] rounded-full">{tech}</span>
                ))}
              </div>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {project.data.tags.map(tag => (
                  <span class="text-xs px-2 py-0.5 bg-[#2d3748]/10 text-[#2d3748] rounded-full">#{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
