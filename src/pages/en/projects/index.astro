---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { useTranslations } from '../../../i18n/translations';
import { getProjects } from '../../../lib/content';

const locale = (Astro.currentLocale ?? 'en') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getProjects(locale);
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(sortedProjects.flatMap(p => p.data.techStack))];
---

<Layout title="Projects — Nikita Nirinovich">
  <main class="min-h-screen bg-primary-dark text-white">
    <section class="border-b-2 border-slate-800">
      <div class="px-8 py-16 sm:px-16 sm:py-20 lg:px-24">
        <h1 class="text-4xl sm:text-5xl font-bold font-heading tracking-tight text-white">Projects</h1>
        <p class="mt-4 text-lg text-slate-400 font-sans">All my projects and work.</p>
      </div>
    </section>

    <!-- Tag Filter -->
    <section class="border-b-2 border-slate-800">
      <div class="px-8 py-8 sm:px-16 lg:px-24">
        <div class="flex flex-wrap gap-2" id="tag-filter">
          <button
            type="button"
            class="tag-pill text-xs font-mono uppercase tracking-widest px-4 py-2 border-2 transition-colors duration-200 cursor-pointer bg-accent text-white border-accent"
            data-tag="all"
          >
            All
          </button>
          {allTags.map(tag => (
            <button
              type="button"
              class="tag-pill text-xs font-mono uppercase tracking-widest px-4 py-2 border-2 transition-colors duration-200 cursor-pointer bg-transparent text-slate-400 border-slate-800 hover:border-slate-600 hover:text-white"
              data-tag={tag}
            >
              {tag}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Grid -->
    <section>
      <div class="px-8 py-12 sm:px-16 sm:py-16 lg:px-24">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
          {sortedProjects.map(project => (
            <div class="project-card-wrapper" data-tags={project.data.techStack.join(',')}>
              <ProjectCard
                title={project.data.title}
                role={project.data.role}
                year={project.data.date.getFullYear().toString()}
                metric={project.data.metric}
                metricLabel={project.data.metricLabel}
                outcome={project.data.outcome}
                before={project.data.before}
                after={project.data.after}
                tags={project.data.techStack}
                client={project.data.client}
                image={project.data.thumbnail}
                liveUrl={project.data.links?.live}
                slug={project.id}
                locale={locale}
                cardVariant={project.data.cardVariant}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const tagFilter = document.getElementById('tag-filter');
  const projectCards = document.querySelectorAll('.project-card-wrapper');
  const tagButtons = document.querySelectorAll('.tag-pill');

  tagFilter?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('tag-pill')) return;

    const selectedTag = target.getAttribute('data-tag');

    // Update button styles
    tagButtons.forEach(btn => {
      const btnTag = btn.getAttribute('data-tag');
      if (btnTag === selectedTag) {
        btn.classList.remove('bg-transparent', 'text-slate-400', 'border-slate-800');
        btn.classList.add('bg-accent', 'text-white', 'border-accent');
      } else {
        btn.classList.remove('bg-accent', 'text-white', 'border-accent');
        btn.classList.add('bg-transparent', 'text-slate-400', 'border-slate-800');
      }
    });

    // Filter projects
    projectCards.forEach(card => {
      const tags = card.getAttribute('data-tags')?.split(',') || [];
      if (selectedTag === 'all' || tags.includes(selectedTag!)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  });
</script>
