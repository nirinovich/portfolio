---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/translations';
import { render } from 'astro:content';
import { getProjects } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project, locale: 'en' },
  }));
}

const { project, locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(project);
const prefix = locale === 'en' ? '/en' : '';
---

<Layout title={`${project.data.title} — Nirinovich`}>
  <main class="min-h-screen bg-[#e8ecf1] pt-24 pb-16 px-4 md:px-8">
    <div class="max-w-3xl mx-auto">
      <a href={prefix + '/#projects'} class="inline-flex items-center gap-2 text-accent hover:text-accent-hover transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        {t('project.back')}
      </a>

      <!-- Header -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">
        <div class="aspect-video bg-accent-light/30 overflow-hidden">
          <img src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-cover" />
        </div>
        <div class="p-6 md:p-8">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-sm text-accent font-medium">{project.data.date.getFullYear()}</span>
            {project.data.client && <span class="text-sm text-[#718096]">· {project.data.client}</span>}
          </div>
          <h1 class="text-2xl md:text-4xl font-bold text-[#2d3748]">{project.data.title}</h1>
          {project.data.role && <p class="text-[#718096] mt-1 text-base">{project.data.role}</p>}
          <p class="text-[#718096] mt-3 text-base md:text-lg">{project.data.description}</p>

          {/* Metric */}
          {project.data.metric && project.data.metricLabel && (
            <div class="flex items-baseline gap-3 mt-4 p-4 bg-accent-ghost rounded-xl">
              <span class="text-2xl md:text-3xl font-bold text-accent">{project.data.metric}</span>
              <span class="text-sm text-[#718096]">{project.data.metricLabel}</span>
            </div>
          )}

          {/* Before/After */}
          {project.data.before && project.data.after && (
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div class="p-4 rounded-xl bg-red-50 border border-red-100">
                <p class="text-sm font-medium text-red-600 mb-1">Before</p>
                <p class="text-[#4a5568]">{project.data.before}</p>
              </div>
              <div class="p-4 rounded-xl bg-green-50 border border-green-100">
                <p class="text-sm font-medium text-green-600 mb-1">After</p>
                <p class="text-[#4a5568]">{project.data.after}</p>
              </div>
            </div>
          )}

          {/* Outcome */}
          {project.data.outcome && (
            <div class="mt-4 p-4 bg-[#f8fafc] rounded-xl">
              <p class="text-sm font-medium text-[#2d3748] mb-1">Outcome</p>
              <p class="text-[#4a5568]">{project.data.outcome}</p>
            </div>
          )}
          
          <div class="flex flex-wrap gap-2 mt-4">
            {project.data.techStack.map(tech => (
              <span class="text-sm px-3 py-1 bg-accent-light text-accent-dark rounded-full font-medium">{tech}</span>
            ))}
          </div>

          <div class="flex flex-wrap gap-2 mt-3">
            {project.data.tags.map(tag => (
              <span class="text-sm px-3 py-1 bg-accent/10 text-accent rounded-full">#{tag}</span>
            ))}
          </div>

          {project.data.links && (
            <div class="flex gap-3 md:gap-4 mt-6">
              {project.data.links.github && (
                <a href={project.data.links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-accent text-white rounded-lg hover:bg-accent-hover transition-colors text-sm">
                  {t('project.links.github')}
                </a>
              )}
              {project.data.links.live && (
                <a href={project.data.links.live} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 border border-accent text-accent rounded-lg hover:bg-accent hover:text-white transition-colors text-sm">
                  {t('project.links.live')}
                </a>
              )}
            </div>
          )}
        </div>
      </div>

      {project.data.gallery && project.data.gallery.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-[#2d3748] mb-4">{t('project.gallery')}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {project.data.gallery.map(img => (
              <div class="rounded-xl overflow-hidden shadow-md">
                <img src={img} alt="" class="w-full h-full object-cover" />
              </div>
            ))}
          </div>
        </div>
      )}

      <article class="prose prose-sm md:prose-lg max-w-none bg-white rounded-2xl shadow-md p-6 md:p-8 prose-headings:text-[#2d3748] prose-a:text-accent">
        <Content />
      </article>
    </div>
  </main>
</Layout>
