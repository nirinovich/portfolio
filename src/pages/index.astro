---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArsenalSection from '../components/ArsenalSection.astro';
import ServicesSection from '../components/ServicesSection.astro';

import CTASection from '../components/CTASection.astro';
import { Lightbulb, Layers, Zap } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { getProjects } from '../lib/content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getProjects(locale);
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 6);

const manifesto = {
  heading: t('manifesto.heading'),
  labels: [t('manifesto.labels.0'), t('manifesto.labels.1'), t('manifesto.labels.2')],
  paragraphs: [t('manifesto.paragraphs.0'), t('manifesto.paragraphs.1'), t('manifesto.paragraphs.2')]
};

const services = [
  {
    title: t('services.1.title'),
    description: t('services.1.description')
  },
  {
    title: t('services.2.title'),
    description: t('services.2.description')
  },
  {
    title: t('services.3.title'),
    description: t('services.3.description')
  },
  {
    title: t('services.4.title'),
    description: t('services.4.description')
  }
];

const experiences = [
  { 
    role: t('experience.1.role'),
    company: t('experience.1.company'),
    period: t('experience.1.period'),
    tasks: [t('experience.1.tasks.0'), t('experience.1.tasks.1'), t('experience.1.tasks.2')],
    link: 'https://exotika.mg'
  },
  { 
    role: t('experience.2.role'),
    company: t('experience.2.company'),
    period: t('experience.2.period'),
    tasks: [t('experience.2.tasks.0'), t('experience.2.tasks.1'), t('experience.2.tasks.2'), t('experience.2.tasks.3')]
  },
  { 
    role: t('experience.3.role'),
    company: t('experience.3.company'),
    period: t('experience.3.period'),
    tasks: [t('experience.3.tasks.0'), t('experience.3.tasks.1'), t('experience.3.tasks.2')],
    link: 'https://malitix.com'
  },
  { 
    role: t('experience.4.role'),
    company: t('experience.4.company'),
    period: t('experience.4.period'),
    tasks: [t('experience.4.tasks.0'), t('experience.4.tasks.1')],
    link: 'https://exotika.mg'
  },
  { 
    role: t('experience.5.role'),
    company: t('experience.5.company'),
    period: t('experience.5.period'),
    tasks: [t('experience.5.tasks.0'), t('experience.5.tasks.1'), t('experience.5.tasks.2')]
  },
];
---

<Layout>
  <main class="bg-primary-dark text-white min-h-screen">
    
    <Hero 
      name="Nikita Nirinovich"
      headline={t('hero.headline')}
      resumeLabel={t('nav.resume')}
      githubLabel="GitHub"
    />

    <!-- Accent spacer -->
    <div class="h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

    <!-- Manifesto -->
    <div class="border-b-2 border-slate-800 px-8 py-12 sm:px-16">
      <h2 class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl font-heading mb-10">
        {manifesto.heading}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {manifesto.paragraphs.map((p, i) => (
          <div class="bg-slate-800 p-6 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              {i === 0 && <Lightbulb class="w-5 h-5 text-accent" />}
              {i === 1 && <Layers class="w-5 h-5 text-accent" />}
              {i === 2 && <Zap class="w-5 h-5 text-accent" />}
              <span class="text-accent font-mono text-xs uppercase tracking-widest">{manifesto.labels[i]}</span>
            </div>
            <p class="text-slate-400 text-base leading-relaxed">{p}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Featured Projects Cards -->
    <div id="featured">
      <SectionHeader 
        title={t('section.featured.title')}
        emphasis={t('section.featured.emphasis')}
        link="/projects"
        linkText={t('featured.viewAll')}
      />
    </div>
    <div class="border-b-2 border-slate-800">
      <div class="mx-auto max-w-6xl px-8 pb-12 sm:px-16">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.slice(0, 3).map((project) => (
            <ProjectCard
              title={project.data.title}
              role={project.data.role}
              year={project.data.date.getFullYear().toString()}
              metric={project.data.metric}
              metricLabel={project.data.metricLabel}
              outcome={project.data.outcome ?? ''}
              tags={project.data.techStack}
              client={project.data.client}
              image={project.data.thumbnail}
              liveUrl={project.data.links?.live}
              slug={project.id}
              locale={locale}
              cardVariant={project.data.cardVariant}
            />
          ))}
        </div>
      </div>
    </div>

    <!-- Experiences Section -->
    <div id="experiences">
      <SectionHeader 
        title={t('section.experience.title')}
        emphasis={t('section.experience.emphasis')}
      />
    </div>

    <!-- Left/Right Timeline -->
    <div class="py-16 border-y-2 border-slate-800 overflow-hidden">
      <div class="max-w-5xl mx-auto px-8 relative">
        <!-- Plane -->
        <div id="timeline-plane" class="absolute left-1/2 top-0 z-20" style="transform: translateX(-50%) translateY(0) rotate(-90deg);">
          <div class="w-8 h-8 text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
          </div>
        </div>

        <div class="relative">
          <div class="absolute left-1/2 top-0 bottom-0 w-px bg-slate-800 -translate-x-1/2"></div>
          
          {experiences.map((exp, i) => (
            <div class={`relative flex items-center pb-12 last:pb-0 experience-item ${i % 2 === 0 ? 'flex-row' : 'flex-row-reverse'}`} style={`--delay: ${i * 0.15}s`} data-index={i}>
              <div class="w-1/2 px-8">
                <div class={`${i % 2 === 0 ? 'text-right' : 'text-left'}`}>
                  <span class="text-xs font-mono text-accent uppercase tracking-wider">{exp.period}</span>
                  <h3 class="text-xl font-bold font-heading text-white mt-1">{exp.role}</h3>
                  <span class="text-sm text-slate-500 font-medium">{exp.company}</span>
                  <ul class={`mt-3 space-y-1.5 ${i % 2 === 0 ? 'ml-auto' : ''}`}>
                    {exp.tasks.map(task => (
                      <li class={`text-slate-400 text-sm leading-relaxed flex items-start gap-2 ${i % 2 === 0 ? 'justify-end' : ''}`}>
                        {i % 2 !== 0 && <span class="text-accent mt-1.5 text-[10px]">▸</span>}
                        <span>{task}</span>
                        {i % 2 === 0 && <span class="text-accent mt-1.5 text-[10px]">◂</span>}
                      </li>
                    ))}
                  </ul>
                  {exp.link && (
                    <a href={exp.link} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-1.5 mt-3 text-xs font-mono text-accent hover:text-white transition-colors ${i % 2 === 0 ? 'ml-auto' : ''}`}>
                      <span>{exp.link.replace('https://', '')}</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                  )}
                </div>
              </div>
              
              <div class="relative z-10 flex-shrink-0">
                <div class="w-8 h-8 rounded-full bg-slate-900 border-2 border-slate-800 flex items-center justify-center group-hover:border-accent transition-colors">
                  <div class="w-2 h-2 rounded-full bg-slate-600 group-hover:bg-accent transition-colors"></div>
                </div>
              </div>
              
              <div class="w-1/2 px-8"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Project Carousel (Variant A: Large) -->
    <div class="border-b-2 border-slate-800 overflow-hidden">
      <div class="carousel-track flex w-max overflow-x-hidden" data-carousel="large">
        {[1, 2].map(() => (
          <Fragment>
            {featuredProjects.map((project) => (
              <a href={`/projects/${project.id}`} class="flex-shrink-0 w-[28rem] group px-2">
                <div class="relative aspect-[16/9] w-full overflow-hidden">
                  <img src={project.data.thumbnail} alt={project.data.title} class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-500 group-hover:scale-110" />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/20 to-transparent"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-6">
                    <h3 class="text-xl font-bold font-heading text-white mb-1">{project.data.title}</h3>
                    <div class="flex items-center gap-3">
                      <span class="text-sm font-mono text-accent">{project.data.date.getFullYear()}</span>
                      <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                      <span class="text-sm text-slate-400">{project.data.techStack?.slice(0, 3).join(' / ')}</span>
                    </div>
                  </div>
                </div>
              </a>
            ))}
            <div class="flex-shrink-0 w-[28rem] px-2">
              <div class="relative aspect-[16/9] w-full border-2 border-dashed border-slate-700 flex flex-col items-center justify-center bg-slate-900 gap-4">
                <svg class="w-12 h-12 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                <span class="text-base font-mono text-slate-600">{t('carousel.yourProject')}</span>
              </div>
            </div>
          </Fragment>
        ))}
      </div>
    </div>

    <!-- The Arsenal -->
    <ArsenalSection
      title={t('section.techStack.title')}
      emphasis={t('section.techStack.emphasis')}
      coreLabel={t('section.techStack.coreLabel')}
    />

    <!-- Services -->
    <ServicesSection
      title={t('section.services.title')}
      emphasis={t('section.services.emphasis')}
      services={services}
      ctaLabel={t('services.cta')}
    />

    <CTASection 
      message={t('cta.message')}
      emailLabel={t('cta.emailLabel')}
    />

  </main>
</Layout>

<script>
  // Epic animation + Plane
  const timelineContainer = document.querySelector('.py-16.border-y-2') as HTMLElement;
  if (timelineContainer) timelineContainer.classList.add('anim-epic');

  const observerOptions = {
    threshold: 0.15,
    rootMargin: '0px 0px -50px 0px'
  };

  const animObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        animObserver.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.experience-item').forEach(item => {
    animObserver.observe(item);
  });

  // Plane scroll: visits each dot, nose-up then flips down
  const plane = document.getElementById('timeline-plane') as HTMLElement;
  if (plane && timelineContainer) {
    const items = Array.from(document.querySelectorAll('.experience-item'));
    const dots = items.map(item => item.querySelector('.relative.z-10'));
    const dotsY = new Array<number>(items.length).fill(0);
    const intersecting = new Set<Element>();
    let activeIndex = 0;
    let lastScrollY = window.scrollY;
    let lastTarget = -1;
    let lastRotation: number | null = null;
    let placed = false;

    // Layout is only ever read here (initial load + resize), never on scroll
    function measureDots() {
      const planeRect = plane.parentElement!.getBoundingClientRect();
      dots.forEach((dot, i) => {
        dotsY[i] = dot ? dot.getBoundingClientRect().top - planeRect.top : 0;
      });
    }

    // Active dot = last item overlapping the top 80% of the viewport.
    // Tracked via the observer, so a scroll event never triggers a reflow.
    const dotObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) intersecting.add(entry.target);
        else intersecting.delete(entry.target);
      });
      for (let i = items.length - 1; i >= 0; i--) {
        if (intersecting.has(items[i])) { activeIndex = i; break; }
      }
      placePlane();
    }, { rootMargin: '0px 0px -20% 0px', threshold: 0 });

    function placePlane() {
      const rotation = window.scrollY < lastScrollY ? -45 : 135;
      lastScrollY = window.scrollY;

      const targetChanged = activeIndex !== lastTarget;
      const rotationChanged = rotation !== lastRotation;
      if (targetChanged) lastTarget = activeIndex;
      if (rotationChanged) lastRotation = rotation;

      // Skip style writes entirely while nothing changed
      if (!targetChanged && !rotationChanged) return;

      plane.style.transition = placed ? 'transform 0.8s ease-in-out' : 'none';
      placed = true;
      plane.style.transform = `translateX(-50%) translateY(${dotsY[activeIndex]}px) rotate(${rotation}deg)`;
    }

    measureDots();
    items.forEach(item => dotObserver.observe(item));
    window.addEventListener('resize', measureDots);
    window.addEventListener('scroll', placePlane, { passive: true });

    // Instant initial placement on the first dot
    placePlane();
  }
</script>
