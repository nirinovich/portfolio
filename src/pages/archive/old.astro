---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 4);

const DEPLOY_TIMESTAMP = Date.now();

// Popup logic...
const popupTitle = locale === 'fr' ? 'Site temporairement bloqué' : 'Site temporarily blocked';
const popupBody = locale === 'fr'
  ? "Tu es une des rares personnes à avoir visité mon site pendant la JMCJ. Je t'invite à me voir en personne pour réseauter, ou revenir un peu plus tard pour jouer à des mini-jeux made in Madagascar."
  : "You're one of the few people who visited my site during JMCJ. Come see me in person to network, or come back later to play mini-games made in Madagascar.";
const popupCta = locale === 'fr' ? 'Compris !' : 'Got it!';
const popupTimerLabel = locale === 'fr' ? 'Site débloqué dans' : 'Site unblocked in';
---

<Layout>
  <!-- Frozen Hero Section -->
  <section id="hero" class="min-h-screen bg-[#e8ecf1] flex items-center justify-center px-4 sm:px-6 py-12 relative">
    <div class="max-w-4xl w-full flex flex-col items-center gap-6 sm:gap-8 md:flex-row md:items-start md:gap-16">
      <div class="flex-shrink-0">
        <div class="profile-card w-44 h-56 sm:w-56 sm:h-[17rem] md:w-72 md:h-[22rem] bg-white rounded-2xl shadow-lg overflow-hidden" style="opacity: 0;">
          <img src="/profile.png" alt="Nikita Nirinovich" class="w-full h-full object-cover" />
        </div>
      </div>
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h1 class="hero-name text-3xl sm:text-4xl md:text-6xl font-bold text-[#2d3748] tracking-tight" style="opacity: 0;">
          Nikita Nirinovich
        </h1>
        <p class="hero-subtitle text-base sm:text-lg md:text-2xl text-[#718096] mt-2 sm:mt-3 font-medium flex items-center gap-2" style="opacity: 0;">
          CS Student @
          <a href="https://esti.mg/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg px-2 py-1 sm:px-3 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-105 transition-all">
            <img src="/logo-ESTI1-foot.svg" alt="ESTI" class="h-5 sm:h-7 inline-block" />
          </a>
        </p>
        <p class="hero-p1 text-sm sm:text-base md:text-lg text-[#4a5568] mt-4 sm:mt-6 max-w-lg leading-relaxed" style="opacity: 0;" set:html={t('hero.bio1')} />
        <p class="hero-p2 text-xs sm:text-sm md:text-base text-[#718096] mt-2 sm:mt-3 max-w-lg leading-relaxed italic" style="opacity: 0;">
          {t('hero.bio2')}
        </p>
        <div class="flex flex-col items-center md:items-start w-full mt-6 sm:mt-10 gap-4">
          <div class="flex flex-wrap justify-center md:justify-start items-center gap-2 sm:gap-3">
            <nav class="flex flex-wrap justify-center md:justify-start items-center gap-2 sm:gap-3">
              <button type="button" class="nav-link blocked-link text-[#4a5568] hover:text-accent text-xs sm:text-sm md:text-base px-3 sm:px-4 py-1.5 rounded-lg bg-[#dde3ec]/60 hover:bg-accent-light transition-all duration-200 cursor-pointer" style="opacity: 0;">
                {t('nav.work')}
              </button>
              <button type="button" class="nav-link blocked-link text-[#4a5568] hover:text-accent text-xs sm:text-sm md:text-base px-3 sm:px-4 py-1.5 rounded-lg bg-[#dde3ec]/60 hover:bg-accent-light transition-all duration-200 cursor-pointer" style="opacity: 0;">
                {t('nav.projects')}
              </button>
              <a href="/resume.pdf" target="_blank" class="nav-link text-[#4a5568] hover:text-accent text-xs sm:text-sm md:text-base px-3 sm:px-4 py-1.5 rounded-lg bg-[#dde3ec]/60 hover:bg-accent-light transition-all duration-200" style="opacity: 0;">
                {t('nav.resume')}
              </a>
            </nav>
            <div class="hidden md:block w-px h-6 bg-[#dde3ec] mx-1"></div>
            <div class="flex items-center gap-4 sm:gap-5">
              <a href="https://github.com/nirinovich" target="_blank" rel="noopener noreferrer" class="social-icon text-[#4a5568] hover:text-accent transition-colors" style="opacity: 0;"><Icon name="mdi:github" class="w-5 h-5 sm:w-6 sm:h-6" /></a>
              <a href="https://www.linkedin.com/in/nirinovich/" target="_blank" rel="noopener noreferrer" class="social-icon text-[#4a5568] hover:text-accent transition-colors" style="opacity: 0;"><Icon name="mdi:linkedin" class="w-5 h-5 sm:w-6 sm:h-6" /></a>
              <a href="mailto:nikita@nirinovich.com" class="social-icon text-[#4a5568] hover:text-accent transition-colors" style="opacity: 0;"><Icon name="mdi:email" class="w-5 h-5 sm:w-6 sm:h-6" /></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Version A: Asymmetrical Flow Overhaul (Cohesive with Hero) -->
  <main class="bg-[#e8ecf1] text-[#2d3748]">
    
    <!-- Narrative Featured Projects -->
    <section class="py-24 px-4 sm:px-8 max-w-7xl mx-auto">
      <div class="mb-24 md:w-2/3 border-l-4 border-accent pl-8">
        <h2 class="text-4xl md:text-6xl font-bold tracking-tight leading-tight mb-6 text-[#2d3748]">
          Crafting <span class="text-accent">impactful</span> experiences.
        </h2>
        <p class="text-xl text-[#718096] font-medium leading-relaxed">
          A curated selection of engineering feats and product design, driven by measurable outcomes.
        </p>
      </div>

      <div class="flex flex-col gap-32">
        {featuredProjects.map((project, index) => (
          <article class={`flex flex-col ${index % 2 !== 0 ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-12 lg:gap-24 group`}>
            
            <div class="w-full md:w-1/2 relative">
              <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-[0_10px_30px_rgba(200,205,215,1)] relative z-10 transform transition-transform duration-700 group-hover:scale-[1.02]">
                <div class="absolute inset-0 bg-[#e8ecf1]/10 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
                <img src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-cover" />
              </div>
            </div>

            <div class="w-full md:w-1/2 flex flex-col justify-center">
              <div class="flex items-center gap-4 mb-6">
                <span class="text-accent font-bold tracking-widest uppercase text-sm">{project.data.role}</span>
                <span class="w-8 h-px bg-[#dde3ec]"></span>
                <span class="text-[#718096] font-medium">{project.data.date.getFullYear()}</span>
              </div>
              
              <h3 class="text-4xl md:text-5xl font-bold mb-6 text-[#2d3748] group-hover:text-accent transition-colors duration-300">{project.data.title}</h3>
              
              <p class="text-lg text-[#4a5568] mb-8 leading-relaxed">
                {project.data.outcome}
              </p>

              <div class="flex flex-wrap gap-2 mb-10">
                {project.data.techStack?.slice(0, 4).map(tech => (
                  <span class="px-4 py-1.5 rounded-full border border-[#dde3ec] text-[#718096] text-sm font-medium bg-white/50 shadow-sm">
                    {tech}
                  </span>
                ))}
              </div>

              <a href={`/projects/${project.id}`} class="inline-flex items-center gap-3 text-lg font-semibold text-[#2d3748] hover:text-accent transition-colors w-max group/link">
                <span class="relative overflow-hidden">
                  Read Case Study
                  <span class="absolute bottom-0 left-0 w-full h-0.5 bg-accent transform -translate-x-[101%] group-hover/link:translate-x-0 transition-transform duration-300 ease-out"></span>
                </span>
                <Icon name="mdi:arrow-right" class="w-6 h-6 transform group-hover/link:translate-x-2 transition-transform duration-300" />
              </a>
            </div>

          </article>
        ))}
      </div>
      
      <div class="mt-32 flex justify-center">
        <a href="/projects" class="px-10 py-4 bg-[#2d3748] text-white rounded-xl font-semibold text-lg hover:bg-accent hover:shadow-xl hover:shadow-accent/30 transition-all duration-300 transform hover:-translate-y-1">
          Explore All Projects
        </a>
      </div>
    </section>

    <!-- Technical Arsenal & Timeline -->
    <section class="py-32 px-4 sm:px-8 bg-white border-t border-[#dde3ec] mt-16 rounded-t-[3rem] shadow-[0_-20px_40px_rgba(200,205,215,0.4)]">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-24">
        
        <!-- Tech Stack -->
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-10 flex items-center gap-4 text-[#2d3748]">
            <Icon name="mdi:code-tags" class="text-accent w-10 h-10" /> Technical Arsenal
          </h2>
          <p class="text-[#718096] mb-12 text-lg leading-relaxed">
            I build robust, scalable applications using modern tooling, focusing on performance and fluid user experiences.
          </p>
          <div class="flex flex-wrap gap-4">
            {['TypeScript', 'React', 'Next.js', 'Astro', 'TailwindCSS', 'Firebase', 'Node.js', 'GSAP'].map(tech => (
              <div class="flex items-center gap-2 px-6 py-4 bg-[#f8fafc] rounded-2xl border border-[#dde3ec] hover:border-accent hover:shadow-md transition-all cursor-default group">
                <span class="font-semibold text-[#4a5568] group-hover:text-accent transition-colors">{tech}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Experience Timeline -->
        <div>
           <h2 class="text-3xl md:text-4xl font-bold mb-10 flex items-center gap-4 text-[#2d3748]">
            <Icon name="mdi:timeline-text-outline" class="text-accent w-10 h-10" /> Experience
          </h2>
          <div class="space-y-12 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-[#dde3ec] before:via-[#dde3ec] before:to-transparent">
            
            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-accent text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
                <Icon name="mdi:briefcase" class="w-4 h-4" />
              </div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 rounded-2xl bg-white border border-[#dde3ec] shadow-sm hover:shadow-lg hover:border-accent/30 transition-all">
                <div class="flex items-center justify-between mb-2">
                  <h4 class="font-bold text-lg text-[#2d3748]">Freelance Engineer</h4>
                  <span class="text-xs font-semibold text-accent bg-accent/10 px-3 py-1 rounded-full">Present</span>
                </div>
                <p class="text-[#718096] text-sm">Full-stack solutions for global clients, specializing in modern web architecture.</p>
              </div>
            </div>
            
             <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-[#e8ecf1] text-[#718096] shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10 transition-colors group-hover:bg-accent group-hover:text-white">
                <Icon name="mdi:school" class="w-4 h-4" />
              </div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 rounded-2xl bg-white border border-[#dde3ec] shadow-sm hover:shadow-lg hover:border-accent/30 transition-all">
                <div class="flex items-center justify-between mb-2">
                  <h4 class="font-bold text-lg text-[#2d3748]">ESTI</h4>
                  <span class="text-xs font-semibold text-[#718096]">2021 - Present</span>
                </div>
                <p class="text-[#718096] text-sm">Computer Science degree focusing on software engineering principles and system design.</p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>
