---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ManifestoSection from '../components/ManifestoSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechStackItem from '../components/TechStackItem.astro';
import CTASection from '../components/CTASection.astro';
import { useTranslations } from '../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 6);

const techStack = [
  { name: 'TypeScript & React', desc: 'Type-safe frontends and scalable UI components for modern applications.' },
  { name: 'Astro & Tailwind', desc: 'High-performance static site generation with utility-first, rapid styling.' },
  { name: 'Firebase & Node.js', desc: 'Robust backend services, real-time databases, and serverless logic.' }
];

const manifesto = {
  heading: 'Engineering fundamentals are your biggest advantage.',
  paragraphs: [
    "A lot of people think the rules of software development are being rewritten. They think that code is cheap.",
    "I build applications that prioritize performance, solid architecture, and measurable business outcomes.",
    "Code isn't cheap. In fact, bad code is the most expensive it's ever been. If you can design systems well, you can reap the rewards.",
    "I specialize in bridging the gap between high-fidelity design and robust full-stack engineering."
  ]
};
---

<Layout>
  <main class="bg-primary-dark text-white max-w-[1200px] mx-auto border-x-2 border-slate-800 min-h-screen">
    
    <Hero 
      name="Nikita Nirinovich"
      subtitle="with Nikita Nirinovich"
      resumeLabel={t('nav.resume')}
      githubLabel="GitHub"
    />

    <ManifestoSection 
      heading={manifesto.heading}
      paragraphs={manifesto.paragraphs}
    />

    <SectionHeader 
      title="Featured Projects"
      emphasis="Projects"
    />
    
    <div class="bg-slate-800 grid w-full grid-cols-1 gap-0.5 border-y-2 border-slate-800 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map(project => (
        <ProjectCard 
          id={project.id}
          title={project.data.title}
          outcome={project.data.outcome}
          thumbnail={project.data.thumbnail}
          year={project.data.date.getFullYear()}
          techStack={project.data.techStack}
        />
      ))}
    </div>

    <SectionHeader 
      title="The Arsenal"
      emphasis="Arsenal"
    />

    <div class="flex flex-col border-y-2 border-slate-800">
      {techStack.map((item, i) => (
        <TechStackItem 
          number={i + 1}
          name={item.name}
          description={item.desc}
        />
      ))}
    </div>
    
    <CTASection 
      message="Ready to build something real?"
      emailLabel="Get in touch"
    />

  </main>
</Layout>
