---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ManifestoSection from '../components/ManifestoSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechStackItem from '../components/TechStackItem.astro';
import CTASection from '../components/CTASection.astro';
import { useTranslations } from '../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 6);

const techStack = [
  { name: 'TypeScript & React', desc: 'Type-safe frontends and scalable UI components for modern applications.', icon: 'react' },
  { name: 'Astro & Tailwind', desc: 'High-performance static site generation with utility-first, rapid styling.', icon: 'astro' },
  { name: 'Firebase & Node.js', desc: 'Robust backend services, real-time databases, and serverless logic.', icon: 'firebase' }
];

const manifesto = {
  heading: 'Good software isn\'t cheap. Bad software is expensive.',
  paragraphs: [
    "I believe in values first — performance, clarity, and outcomes over features and buzzwords.",
    "Every line of code is a liability. Bad debt compounds. I build systems that stay clean under pressure.",
    "AI is rewriting the rules, but someone still has to manage the machine. That's where I come in.",
    "I bridge the gap between design intent and production-grade engineering — delivering results, not just code."
  ]
};
---

<Layout>
  <!-- Nav Variant B: Sticky top navbar (hidden by default) -->
  <nav id="nav-b" class="hidden fixed top-0 left-0 right-0 z-50 bg-primary-dark/95 backdrop-blur-sm border-b-2 border-slate-800 px-8 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-xl font-bold font-heading text-white">Nirinovich</a>
      <div class="flex items-center gap-6">
        <a href="#featured" class="text-sm text-slate-400 hover:text-white transition-colors">{t('nav.work')}</a>
        <a href="/resume.pdf" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors">{t('nav.resume')}</a>
        <a href="https://github.com/nirinovich" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors">GitHub</a>
      </div>
    </div>
  </nav>

  <!-- Nav Toggle (dev only) -->
  <button id="nav-toggle" class="fixed bottom-4 right-4 z-[100] bg-slate-800 text-slate-400 text-xs px-3 py-1.5 border border-slate-700 hover:bg-slate-700 hover:text-white transition-colors" title="Toggle nav variant (press N)">
    Nav: <span id="nav-label">A</span>
  </button>

  <main class="bg-primary-dark text-white min-h-screen">
    
    <Hero 
      name="Nikita Nirinovich"
      subtitle="with Nikita Nirinovich"
      resumeLabel={t('nav.resume')}
      githubLabel="GitHub"
    />

    <ManifestoSection 
      heading={manifesto.heading}
      paragraphs={manifesto.paragraphs}
    />

    <SectionHeader 
      title="Featured Projects"
      emphasis="Projects"
    />
    
    <div class="bg-slate-800 grid w-full grid-cols-1 gap-0.5 border-y-2 border-slate-800 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map(project => (
        <ProjectCard 
          id={project.id}
          title={project.data.title}
          outcome={project.data.outcome}
          thumbnail={project.data.thumbnail}
          year={project.data.date.getFullYear()}
          techStack={project.data.techStack}
        />
      ))}
    </div>

    <SectionHeader 
      title="The Arsenal"
      emphasis="Arsenal"
    />

    <div class="flex flex-col border-y-2 border-slate-800">
      {techStack.map((item, i) => (
        <TechStackItem 
          number={i + 1}
          name={item.name}
          description={item.desc}
          icon={item.icon}
        />
      ))}
    </div>
    
    <CTASection 
      message="Ready to build something real?"
      emailLabel="Get in touch"
    />

  </main>
</Layout>

<script>
  const navB = document.getElementById('nav-b');
  const navLabel = document.getElementById('nav-label');
  const toggleBtn = document.getElementById('nav-toggle');
  let variant: 'a' | 'b' = 'a';

  function toggleNav() {
    variant = variant === 'a' ? 'b' : 'a';
    if (variant === 'b') {
      navB?.classList.remove('hidden');
      navLabel!.textContent = 'B';
    } else {
      navB?.classList.add('hidden');
      navLabel!.textContent = 'A';
    }
  }

  toggleBtn?.addEventListener('click', toggleNav);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'n' || e.key === 'N') {
      if (e.target instanceof HTMLElement && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
        toggleNav();
      }
    }
  });
</script>
