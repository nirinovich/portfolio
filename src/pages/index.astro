---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechStackItem from '../components/TechStackItem.astro';
import CTASection from '../components/CTASection.astro';
import { Lightbulb, Layers, Zap } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 6);

const techStack = [
  { name: 'TypeScript & React', desc: locale === 'fr' ? 'Frontends typés et composants UI scalables pour applications modernes.' : 'Type-safe frontends and scalable UI components for modern applications.', icon: 'react' },
  { name: 'Astro & Tailwind', desc: locale === 'fr' ? 'Génération de sites statiques haute performance avec styling utilitaire rapide.' : 'High-performance static site generation with utility-first, rapid styling.', icon: 'astro' },
  { name: 'Firebase & Node.js', desc: locale === 'fr' ? 'Services backend robustes, bases de données temps réel et logique serverless.' : 'Robust backend services, real-time databases, and serverless logic.', icon: 'firebase' }
];

const manifesto = {
  heading: locale === 'fr' ? 'Ce qui me différencie' : 'What sets me apart',
  labels: locale === 'fr' ? ['Business first', 'Tout-en-un', 'Zéro ghosting'] : ['Business first', 'All-in-one', 'Zero ghosting'],
  paragraphs: locale === 'fr' ? [
    "Je comprends la logique business. Un site web n'est pas une œuvre d'art, c'est un outil qui doit générer du chiffre.",
    "Tout au même endroit. Je développe votre site ET je gère votre IT, pas besoin de jongler entre 5 prestataires.",
    "Zéro ghosting. Je réponds vite, je livre à temps, et je reste jusqu'à ce que ça tourne."
  ] : [
    "I understand business logic. A website isn't art, it's a tool that should drive revenue.",
    "Everything in one place. I build your site AND manage your IT, no need to juggle 5 freelancers.",
    "Zero ghosting. I reply fast, deliver on time, and stay until it works."
  ]
};

const experiences = [
  { 
    role: locale === 'fr' ? 'Consultant IT' : 'IT Consultant',
    company: 'Exotika.mg',
    period: locale === 'fr' ? '2026 — Présent' : '2026 — Present',
    tasks: locale === 'fr' ? [
      "Migration du site statique vers une plateforme ecommerce",
      "Intégration de l'ERP Odoo pour la gestion des stocks et commandes",
      "Gestion technique et optimisation des performances"
    ] : [
      "Migration from static site to ecommerce platform",
      "Odoo ERP integration for inventory and order management",
      "Technical management and performance optimization"
    ],
    link: 'https://exotika.mg'
  },
  { 
    role: locale === 'fr' ? 'Alternant: Marketing/Business Analyst' : 'Intern: Marketing/Business Analyst',
    company: 'eTech Consulting',
    period: locale === 'fr' ? 'Sept 2025 — Mars 2026' : 'Sept 2025 — Mar 2026',
    tasks: locale === 'fr' ? [
      "Assistant de l'équipe commerciale locale et Offshore",
      "Compréhension fonctionnelle et technique des besoins du client",
      "Conception des propositions commerciales et des plaquettes",
      "Élaboration des offres et suivi des opportunités"
    ] : [
      "Assistant to local and Offshore commercial team",
      "Functional and technical understanding of client needs",
      "Design of commercial proposals and brochures",
      "Offer development and opportunity tracking"
    ]
  },
  { 
    role: locale === 'fr' ? 'Indépendant: Développeur React' : 'Independent: React Developer',
    company: 'Malitix (branche eTech Consulting)',
    period: locale === 'fr' ? 'Sept 2025 — Mars 2026' : 'Sept 2025 — Mar 2026',
    tasks: locale === 'fr' ? [
      "Création intégrale d'une plateforme web dédiée à l'acquisition de clients offshore",
      "Développement frontend React et intégration API",
      "Conception de l'architecture technique et déploiement"
    ] : [
      "End-to-end creation of a web platform for offshore client acquisition",
      "React frontend development and API integration",
      "Technical architecture design and deployment"
    ],
    link: 'https://malitix.com'
  },
  { 
    role: locale === 'fr' ? 'Développeur React & Javascript' : 'React & JavaScript Developer',
    company: 'Exotika.mg',
    period: locale === 'fr' ? 'Juin 2025 — Juil 2025' : 'Jun 2025 — Jul 2025',
    tasks: locale === 'fr' ? [
      "Création complète du site internet pour une boutique de vape",
      "Déploiement sur Firebase avec intégration CMS Contentful"
    ] : [
      "Complete website creation for a vape shop",
      "Firebase deployment with Contentful CMS integration"
    ],
    link: 'https://exotika.mg'
  },
  { 
    role: 'Community Manager',
    company: "L'Art Blanc",
    period: locale === 'fr' ? 'Juil 2024 — Jan 2026' : 'Jul 2024 — Jan 2026',
    tasks: locale === 'fr' ? [
      "Création et publication de contenu digital",
      "Réalisation des éléments graphiques",
      "Élaboration des campagnes publicitaires"
    ] : [
      "Digital content creation and publishing",
      "Graphic design production",
      "Advertising campaign development"
    ]
  },
];
---

<Layout>
  <!-- Variant Toggle (Carousel) -->
  <div class="fixed bottom-4 right-4 z-[100] flex gap-1">
    <button data-variant="large" class="variant-btn bg-accent text-white text-xs px-3 py-1.5 transition-colors" title="Carousel: Large (L)">L</button>
    <button data-variant="minimal" class="variant-btn bg-slate-800 text-slate-400 text-xs px-3 py-1.5 border border-slate-700 hover:bg-slate-700 hover:text-white transition-colors" title="Carousel: Minimal (B)">B</button>
  </div>

  <main class="bg-primary-dark text-white min-h-screen">
    
    <Hero 
      name="Nikita Nirinovich"
      headline={t('hero.headline')}
      resumeLabel={t('nav.resume')}
      githubLabel="GitHub"
      workLabel={t('nav.work')}
      projectsLabel={t('nav.projects')}
      langSwitchLabel={t('language.switch')}
      langSwitchHref={locale === 'fr' ? '/en' : '/'}
    />

    <!-- Accent spacer -->
    <div class="h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

    <!-- Manifesto -->
    <div class="border-b-2 border-slate-800 px-8 py-12 sm:px-16">
      <h2 class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl font-heading mb-10">
        {manifesto.heading}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {manifesto.paragraphs.map((p, i) => (
          <div class="bg-slate-800 p-6 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              {i === 0 && <Lightbulb class="w-5 h-5 text-accent" />}
              {i === 1 && <Layers class="w-5 h-5 text-accent" />}
              {i === 2 && <Zap class="w-5 h-5 text-accent" />}
              <span class="text-accent font-mono text-xs uppercase tracking-widest">{manifesto.labels[i]}</span>
            </div>
            <p class="text-slate-400 text-base leading-relaxed">{p}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Featured Projects Section -->
    <div id="featured">
      <SectionHeader 
        title={t('section.featured.title')}
        emphasis={locale === 'fr' ? 'Sélectionnés' : 'Featured'}
        link="/projects"
        linkText={t('featured.viewAll')}
      />
    </div>
    
    <!-- Project Carousel -->
    <div class="border-b-2 border-slate-800">
      <div class="relative">
        <!-- Variant L: Large -->
        <div id="variant-large" class="carousel-variant overflow-x-hidden">
          <div class="carousel-track flex w-max" data-carousel="large">
            {[1, 2].map(() => (
              <Fragment>
                {featuredProjects.map((project) => (
                  <a href={`/projects/${project.id}`} class="flex-shrink-0 w-[28rem] group px-2">
                    <div class="relative aspect-[16/9] w-full overflow-hidden">
                      <img src={project.data.thumbnail} alt={project.data.title} class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-500 group-hover:scale-110" />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/20 to-transparent"></div>
                      <div class="absolute bottom-0 left-0 right-0 p-6">
                        <h3 class="text-xl font-bold font-heading text-white mb-1">{project.data.title}</h3>
                        <div class="flex items-center gap-3">
                          <span class="text-sm font-mono text-accent">{project.data.date.getFullYear()}</span>
                          <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                          <span class="text-sm text-slate-400">{project.data.techStack?.slice(0, 3).join(' / ')}</span>
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
                <div class="flex-shrink-0 w-[28rem] px-2">
                  <div class="relative aspect-[16/9] w-full border-2 border-dashed border-slate-700 flex flex-col items-center justify-center bg-slate-900 gap-4">
                    <svg class="w-12 h-12 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    <span class="text-base font-mono text-slate-600">{locale === 'fr' ? 'Votre projet' : 'Your project'}</span>
                  </div>
                </div>
              </Fragment>
            ))}
          </div>
        </div>

        <!-- Variant B: Minimal (Logo + Title, screenshot on hover) -->
        <div id="variant-minimal" class="carousel-variant hidden overflow-x-hidden">
          <div class="carousel-track flex w-max" data-carousel="minimal">
            {[1, 2].map(() => (
              <Fragment>
                {featuredProjects.map((project) => (
                  <a href={`/projects/${project.id}`} class="flex-shrink-0 w-[28rem] group px-2">
                    <div class="relative aspect-[16/9] w-full overflow-hidden bg-slate-900 border border-slate-800 transition-all duration-500 group-hover:border-accent">
                      <!-- Default state: Logo + Title -->
                      <div class="absolute inset-0 flex items-center gap-5 p-8 transition-opacity duration-500 group-hover:opacity-0">
                        <div class="w-14 h-14 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center flex-shrink-0">
                          <span class="text-2xl font-bold font-heading text-accent">{project.data.title.charAt(0)}</span>
                        </div>
                        <div>
                          <h3 class="text-xl font-bold font-heading text-white">{project.data.title}</h3>
                          <span class="text-sm font-mono text-slate-500">{project.data.date.getFullYear()}</span>
                        </div>
                      </div>
                      <!-- Hover state: Screenshot -->
                      <img src={project.data.thumbnail} alt={project.data.title} class="absolute inset-0 w-full h-full object-cover object-top opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/20 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                      <div class="absolute bottom-0 left-0 right-0 p-6 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                        <h3 class="text-lg font-bold font-heading text-white mb-1">{project.data.title}</h3>
                        <div class="flex items-center gap-3">
                          <span class="text-sm font-mono text-accent">{project.data.date.getFullYear()}</span>
                          <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                          <span class="text-sm text-slate-400">{project.data.techStack?.slice(0, 3).join(' / ')}</span>
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
                <div class="flex-shrink-0 w-[28rem] px-2">
                  <div class="relative aspect-[16/9] w-full border-2 border-dashed border-slate-700 flex flex-col items-center justify-center bg-slate-900 gap-4">
                    <svg class="w-12 h-12 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    <span class="text-base font-mono text-slate-600">{locale === 'fr' ? 'Votre projet' : 'Your project'}</span>
                  </div>
                </div>
              </Fragment>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Experiences Section -->
    <div id="experiences">
      <SectionHeader 
        title={t('section.experience.title')}
        emphasis={locale === 'fr' ? 'Expérience' : 'Experience'}
      />
    </div>

    <!-- Left/Right Timeline -->
    <div class="py-16 border-y-2 border-slate-800 overflow-hidden">
      <div class="max-w-5xl mx-auto px-8 relative">
        <!-- Plane -->
        <div id="timeline-plane" class="absolute left-1/2 top-0 z-20" style="transform: translateX(-50%) translateY(0) rotate(-90deg);">
          <div class="w-8 h-8 text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
          </div>
        </div>

        <div class="relative">
          <div class="absolute left-1/2 top-0 bottom-0 w-px bg-slate-800 -translate-x-1/2"></div>
          
          {experiences.map((exp, i) => (
            <div class={`relative flex items-center pb-12 last:pb-0 experience-item ${i % 2 === 0 ? 'flex-row' : 'flex-row-reverse'}`} style={`--delay: ${i * 0.15}s`} data-index={i}>
              <div class="w-1/2 px-8">
                <div class={`${i % 2 === 0 ? 'text-right' : 'text-left'}`}>
                  <span class="text-xs font-mono text-accent uppercase tracking-wider">{exp.period}</span>
                  <h3 class="text-xl font-bold font-heading text-white mt-1">{exp.role}</h3>
                  <span class="text-sm text-slate-500 font-medium">{exp.company}</span>
                  <ul class={`mt-3 space-y-1.5 ${i % 2 === 0 ? 'ml-auto' : ''}`}>
                    {exp.tasks.map(task => (
                      <li class={`text-slate-400 text-sm leading-relaxed flex items-start gap-2 ${i % 2 === 0 ? 'justify-end' : ''}`}>
                        {i % 2 !== 0 && <span class="text-accent mt-1.5 text-[10px]">▸</span>}
                        <span>{task}</span>
                        {i % 2 === 0 && <span class="text-accent mt-1.5 text-[10px]">◂</span>}
                      </li>
                    ))}
                  </ul>
                  {exp.link && (
                    <a href={exp.link} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-1.5 mt-3 text-xs font-mono text-accent hover:text-white transition-colors ${i % 2 === 0 ? 'ml-auto' : ''}`}>
                      <span>{exp.link.replace('https://', '')}</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                  )}
                </div>
              </div>
              
              <div class="relative z-10 flex-shrink-0">
                <div class="w-8 h-8 rounded-full bg-slate-900 border-2 border-slate-800 flex items-center justify-center group-hover:border-accent transition-colors">
                  <div class="w-2 h-2 rounded-full bg-slate-600 group-hover:bg-accent transition-colors"></div>
                </div>
              </div>
              
              <div class="w-1/2 px-8"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- The Arsenal -->
    <SectionHeader 
      title={t('section.arsenal.title')}
      emphasis={locale === 'fr' ? 'Arsenal' : 'Arsenal'}
    />

    <div class="flex flex-col border-y-2 border-slate-800">
      {techStack.map((item, i) => (
        <TechStackItem 
          number={i + 1}
          name={item.name}
          description={item.desc}
          icon={item.icon}
        />
      ))}
    </div>
    
    <CTASection 
      message={t('cta.message')}
      emailLabel={t('cta.emailLabel')}
    />

  </main>
</Layout>

<script>
  // Carousel variant switching
  const variantBtns = document.querySelectorAll('[data-variant]');
  const variants = document.querySelectorAll('.carousel-variant');
  
  function switchVariant(name: string) {
    variantBtns.forEach(btn => {
      const isActive = btn.getAttribute('data-variant') === name;
      btn.classList.toggle('bg-accent', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('bg-slate-800', !isActive);
      btn.classList.toggle('text-slate-400', !isActive);
    });
    variants.forEach(v => v.classList.add('hidden'));
    const active = document.getElementById(`variant-${name}`);
    if (active) active.classList.remove('hidden');
  }

  variantBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const variant = btn.getAttribute('data-variant');
      if (variant) switchVariant(variant);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLElement && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    if (e.key === 'l' || e.key === 'L') switchVariant('large');
    if (e.key === 'b' || e.key === 'B') switchVariant('minimal');
  });

  // Epic animation + Plane
  const timelineContainer = document.querySelector('.py-16.border-y-2') as HTMLElement;
  if (timelineContainer) timelineContainer.classList.add('anim-epic');

  const observerOptions = {
    threshold: 0.15,
    rootMargin: '0px 0px -50px 0px'
  };

  const animObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        animObserver.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.experience-item').forEach(item => {
    animObserver.observe(item);
  });

  // Plane scroll: visits each dot, nose-up then flips down
  const plane = document.getElementById('timeline-plane');
  if (plane && timelineContainer) {
    let lastScrollY = window.scrollY;
    
    function updatePlanePosition(isInitial = false) {
      const currentScrollY = window.scrollY;
      const isScrollingUp = currentScrollY < lastScrollY;
      lastScrollY = currentScrollY;
      
      const viewportH = window.innerHeight;
      const experienceItems = document.querySelectorAll('.experience-item');
      if (!experienceItems.length) return;

      const items = Array.from(experienceItems);
      let activeIndex = 0;

      for (let i = 0; i < items.length; i++) {
        const rect = items[i].getBoundingClientRect();
        if (rect.top < viewportH * 0.8) {
          activeIndex = i;
        }
      }

      const targetItem = items[activeIndex];
      const dot = targetItem.querySelector('.relative.z-10');
      if (dot) {
        const dotRect = dot.getBoundingClientRect();
        const planeContainerRect = plane.parentElement!.getBoundingClientRect();
        const targetY = dotRect.top - planeContainerRect.top;
        
        // Default to pointing down if it's the initial load
        const rotation = isInitial ? 135 : (isScrollingUp ? -45 : 135);
        
        // Remove transition for the instant initial placement
        plane.style.transition = isInitial ? 'none' : 'transform 0.8s ease-in-out';
        plane.style.transform = `translateX(-50%) translateY(${targetY}px) rotate(${rotation}deg)`;
      }
    }
    
    // Set initial position instantly
    updatePlanePosition(true);
    
    // Listen for scroll to animate
    window.addEventListener('scroll', () => updatePlanePosition(false));
  }
</script>
