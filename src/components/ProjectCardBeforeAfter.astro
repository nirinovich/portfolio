---
interface Props {
  title: string;
  role?: string;
  year: string;
  metric?: string;
  metricLabel?: string;
  before?: string;
  after?: string;
  tags: string[];
  client?: string;
  image?: string;
  liveUrl?: string;
  repoUrl?: string;
  slug: string;
  locale: string;
}

const { title, role, year, metric, metricLabel, before, after, tags, client, image, liveUrl, repoUrl, slug, locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
---

<a href={`${prefix}/projects/${slug}`} class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-transparent hover:border-accent/20">
  {image && (
    <div class="aspect-video bg-[#f1f5f9] overflow-hidden flex items-center justify-center p-6">
      <img src={image} alt={title} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" />
    </div>
  )}
  <div class="p-5">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs text-accent font-medium">{year}</span>
      {client && <span class="text-xs text-[#718096]">· {client}</span>}
    </div>
    <div class="flex items-center gap-2 mb-3">
      <h3 class="text-lg font-bold text-[#2d3748] group-hover:text-accent transition-colors">{title}</h3>
      {liveUrl && <span class="text-xs px-2 py-0.5 bg-accent text-white rounded-full">Live</span>}
    </div>
    {role && <p class="text-sm text-[#718096] mb-3">{role}</p>}

    <div class="grid grid-cols-2 gap-3 mb-3">
      <div class="p-3 rounded-lg bg-red-50 border border-red-100">
        <p class="text-xs font-medium text-red-600 mb-1">Before</p>
        <p class="text-sm text-[#4a5568]">{before || '—'}</p>
      </div>
      <div class="p-3 rounded-lg bg-green-50 border border-green-100">
        <p class="text-xs font-medium text-green-600 mb-1">After</p>
        <p class="text-sm text-[#4a5568]">{after || '—'}</p>
      </div>
    </div>

    {metric && metricLabel && (
      <div class="flex items-baseline gap-2 mb-3">
        <span class="text-lg font-bold text-accent">{metric}</span>
        <span class="text-xs text-[#718096]">{metricLabel}</span>
      </div>
    )}

    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => <span class="text-xs px-2 py-0.5 bg-accent-light text-accent-dark rounded-full">{tag}</span>)}
    </div>
  </div>
</a>
