---
// CTASection component - Call-to-action section with email link
import { Icon } from 'astro-icon/components';

interface Props {
  message: string;
  emailLabel: string;
  email?: string;
  class?: string;
}

const { 
  message, 
  emailLabel, 
  email = 'nikita@nirinovich.com',
  class: className = '' 
} = Astro.props;
---

<div class:list={[
  "py-24 flex justify-center border-b-2 border-slate-800 bg-slate-900",
  className
]}>
  <div class="text-center">
    <p class="text-slate-400 font-sans mb-6 text-lg">
      {message}
    </p>
    <a href={`mailto:${email}`} class="inline-flex items-center gap-3 bg-accent text-white px-10 py-5 font-bold uppercase tracking-wider text-base hover:bg-accent-hover transition-colors">
      {emailLabel} <Icon name="mdi:email" class="w-6 h-6" />
    </a>
  </div>
</div>
