---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'en') as 'fr' | 'en';
const t = useTranslations(locale);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const prefix = locale === 'en' ? '/en' : '';
---

<Layout title={`${t('nav.blog')} — Nirinovich`}>
  <main class="min-h-screen bg-[#e8ecf1] pt-24 pb-16 px-4 md:px-8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-[#2d3748] mb-10 md:mb-12">{t('nav.blog')}</h1>

      <div class="space-y-4 md:space-y-6">
        {sortedPosts.map(post => (
          <a href={`${prefix}/blog/${post.id}`} class="block bg-white rounded-2xl shadow-md p-5 md:p-6 hover:shadow-lg transition-all group border border-transparent hover:border-accent/20">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 md:gap-4">
              <div class="min-w-0">
                <h2 class="text-lg md:text-xl font-semibold text-[#2d3748] group-hover:text-accent transition-colors">{post.data.title}</h2>
                <p class="text-[#718096] mt-2 text-sm md:text-base">{post.data.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {post.data.tags.map(tag => (
                    <span class="text-xs px-2 py-0.5 bg-accent-light text-accent-dark rounded-full">#{tag}</span>
                  ))}
                </div>
              </div>
              <span class="text-sm text-[#718096] shrink-0">
                {post.data.date.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
