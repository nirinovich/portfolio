---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ManifestoSection from '../components/ManifestoSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechStackItem from '../components/TechStackItem.astro';
import CTASection from '../components/CTASection.astro';
import { useTranslations } from '../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = sortedProjects.filter(p => p.data.featured).slice(0, 6);

const techStack = [
  { name: 'TypeScript & React', desc: locale === 'fr' ? 'Frontends typés et composants UI scalables pour applications modernes.' : 'Type-safe frontends and scalable UI components for modern applications.', icon: 'react' },
  { name: 'Astro & Tailwind', desc: locale === 'fr' ? 'Génération de sites statiques haute performance avec styling utilitaire rapide.' : 'High-performance static site generation with utility-first, rapid styling.', icon: 'astro' },
  { name: 'Firebase & Node.js', desc: locale === 'fr' ? 'Services backend robustes, bases de données temps réel et logique serverless.' : 'Robust backend services, real-time databases, and serverless logic.', icon: 'firebase' }
];

const manifesto = {
  heading: locale === 'fr' ? 'Votre site web devrait travailler pour vous, pas contre vous.' : 'Your website should work for you, not against you.',
  paragraphs: locale === 'fr' ? [
    "Je crée des sites web et gère l'IT pour des petites entreprises — pas pour le plaisir, pour des résultats. Chaque projet a un objectif : plus de leads, plus de ventes, moins de maux de tête.",
    "Vous ne serez pas abandonné. Je livre à temps, communique clairement et reste jusqu'à ce que ça fonctionne.",
    "Je mesure ce qui compte. Trafic, conversions, uptime — pas les métriques de vitrine."
  ] : [
    "I build websites and manage IT for small businesses — not for fun, for results. Every project has a goal: more leads, more sales, less headaches.",
    "You won't get ghosted. I deliver on time, communicate clearly, and stay until it works.",
    "I measure what matters. Traffic, conversions, uptime — not vanity metrics."
  ]
};

const experiences = [
  { roleKey: 'experience.1.role' as const, periodKey: 'experience.1.period' as const, descKey: 'experience.1.description' as const },
  { roleKey: 'experience.2.role' as const, periodKey: 'experience.2.period' as const, descKey: 'experience.2.description' as const },
  { roleKey: 'experience.3.role' as const, periodKey: 'experience.3.period' as const, descKey: 'experience.3.description' as const },
];
---

<Layout>
  <!-- Nav Variant B: Sticky top navbar (hidden by default) -->
  <nav id="nav-b" class="hidden fixed top-0 left-0 right-0 z-50 bg-primary-dark/95 backdrop-blur-sm border-b-2 border-slate-800 px-8 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-xl font-bold font-heading text-white">Nirinovich</a>
      <div class="flex items-center gap-6">
        <a href="#featured" class="text-sm text-slate-400 hover:text-white transition-colors">{t('nav.work')}</a>
        <a href="/resume.pdf" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors">{t('nav.resume')}</a>
        <a href="https://github.com/nirinovich" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors">GitHub</a>
      </div>
    </div>
  </nav>

  <!-- Nav/Experience Toggle (dev only) -->
  <div class="fixed bottom-4 right-4 z-[100] flex flex-col gap-2">
    <button id="nav-toggle" class="bg-slate-800 text-slate-400 text-xs px-3 py-1.5 border border-slate-700 hover:bg-slate-700 hover:text-white transition-colors" title="Toggle nav variant (press N)">
      Nav: <span id="nav-label">A</span>
    </button>
    <button id="exp-toggle" class="bg-slate-800 text-slate-400 text-xs px-3 py-1.5 border border-slate-700 hover:bg-slate-700 hover:text-white transition-colors" title="Toggle experience style (press E)">
      Exp: <span id="exp-label">Marquee</span>
    </button>
  </div>

  <main class="bg-primary-dark text-white min-h-screen">
    
    <Hero 
      name="Nikita Nirinovich"
      resumeLabel={t('nav.resume')}
      githubLabel="GitHub"
      workLabel={t('nav.work')}
      projectsLabel={t('nav.projects')}
    />

    <!-- Accent spacer -->
    <div class="h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

    <ManifestoSection 
      heading={manifesto.heading}
      paragraphs={manifesto.paragraphs}
    />

    <!-- Featured Projects Section -->
    <div id="featured">
      <SectionHeader 
        title={t('section.featured.title')}
        emphasis={locale === 'fr' ? 'Sélectionnés' : 'Featured'}
        link="/projects"
        linkText={t('featured.viewAll')}
      />
    </div>
    
    <div class="bg-slate-800 grid w-full grid-cols-1 gap-0.5 border-y-2 border-slate-800 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map(project => (
        <ProjectCard 
          id={project.id}
          title={project.data.title}
          outcome={project.data.outcome}
          thumbnail={project.data.thumbnail}
          year={project.data.date.getFullYear()}
          techStack={project.data.techStack}
        />
      ))}
    </div>

    <!-- View all projects CTA -->
    <div class="py-12 flex justify-center border-b-2 border-slate-800">
      <a href="/projects" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors font-medium">
        {t('featured.viewAll')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Experiences Section -->
    <div id="experiences">
      <SectionHeader 
        title={t('section.experience.title')}
        emphasis={locale === 'fr' ? 'Expérience' : 'Experience'}
      />
    </div>

    <!-- Variant A: Marquee -->
    <div id="exp-marquee" class="py-16 border-y-2 border-slate-800 overflow-hidden relative">
      <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-primary-dark to-transparent z-10"></div>
      <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-primary-dark to-transparent z-10"></div>
      
      <div class="flex items-center gap-16 whitespace-nowrap">
        {[0, 1].map(() => (
          <div class="flex items-center gap-16 animate-[marquee_20s_linear_infinite]">
            {experiences.map((exp) => (
              <div class="flex items-center gap-6">
                <div class="flex flex-col">
                  <span class="text-xl font-bold font-heading text-white">{t(exp.roleKey)}</span>
                  <span class="text-sm text-accent">{t(exp.periodKey)}</span>
                </div>
                <span class="text-accent text-2xl">✦</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Variant B: Vertical Timeline (hidden by default) -->
    <div id="exp-timeline" class="hidden py-16 border-y-2 border-slate-800">
      <div class="max-w-3xl mx-auto px-8">
        <div class="relative">
          <!-- Vertical line -->
          <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-800"></div>
          
          {experiences.map((exp, i) => (
            <div class="relative flex gap-8 pb-12 last:pb-0 group">
              <!-- Dot -->
              <div class="relative z-10 flex-shrink-0">
                <div class="w-8 h-8 rounded-full bg-slate-900 border-2 border-slate-800 flex items-center justify-center group-hover:border-accent transition-colors">
                  <div class="w-2 h-2 rounded-full bg-slate-600 group-hover:bg-accent transition-colors"></div>
                </div>
              </div>
              
              <!-- Content -->
              <div class="flex-1 pt-1">
                <span class="text-xs font-mono text-accent uppercase tracking-wider">{t(exp.periodKey)}</span>
                <h3 class="text-xl font-bold font-heading text-white mt-2">{t(exp.roleKey)}</h3>
                <p class="text-slate-400 mt-2 text-sm leading-relaxed">{t(exp.descKey)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- The Arsenal -->
    <SectionHeader 
      title={t('section.arsenal.title')}
      emphasis={locale === 'fr' ? 'Arsenal' : 'Arsenal'}
    />

    <div class="flex flex-col border-y-2 border-slate-800">
      {techStack.map((item, i) => (
        <TechStackItem 
          number={i + 1}
          name={item.name}
          description={item.desc}
          icon={item.icon}
        />
      ))}
    </div>
    
    <CTASection 
      message={t('cta.message')}
      emailLabel={t('cta.emailLabel')}
    />

  </main>
</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
</style>

<script>
  const navA = document.getElementById('nav-a');
  const navB = document.getElementById('nav-b');
  const navLabel = document.getElementById('nav-label');
  const navToggle = document.getElementById('nav-toggle');
  
  const expMarquee = document.getElementById('exp-marquee');
  const expTimeline = document.getElementById('exp-timeline');
  const expLabel = document.getElementById('exp-label');
  const expToggle = document.getElementById('exp-toggle');

  let navVariant: 'a' | 'b' = 'a';
  let expVariant: 'marquee' | 'timeline' = 'marquee';

  function toggleNav() {
    navVariant = navVariant === 'a' ? 'b' : 'a';
    if (navVariant === 'b') {
      navA?.classList.add('hidden');
      navB?.classList.remove('hidden');
      navLabel!.textContent = 'B';
    } else {
      navA?.classList.remove('hidden');
      navB?.classList.add('hidden');
      navLabel!.textContent = 'A';
    }
  }

  function toggleExp() {
    expVariant = expVariant === 'marquee' ? 'timeline' : 'marquee';
    if (expVariant === 'timeline') {
      expMarquee?.classList.add('hidden');
      expTimeline?.classList.remove('hidden');
      expLabel!.textContent = 'Timeline';
    } else {
      expMarquee?.classList.remove('hidden');
      expTimeline?.classList.add('hidden');
      expLabel!.textContent = 'Marquee';
    }
  }

  navToggle?.addEventListener('click', toggleNav);
  expToggle?.addEventListener('click', toggleExp);
  
  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLElement && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    
    if (e.key === 'n' || e.key === 'N') toggleNav();
    if (e.key === 'e' || e.key === 'E') toggleExp();
  });
</script>
