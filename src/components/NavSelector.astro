---
// NavSelector — development-only component for A/B testing navigation styles
---

<div id="nav-selector" class="fixed bottom-4 left-4 z-[100] bg-white/90 backdrop-blur-md rounded-xl shadow-lg p-3 flex items-center gap-2 text-xs border border-[#dde3ec]">
  <span class="text-[#718096] font-medium">Nav:</span>
  <button data-nav="fab" class="nav-choice px-2 py-1 rounded-lg text-[#718096] hover:bg-[#dde3ec] transition-all">FAB</button>
  <button data-nav="rail" class="nav-choice px-2 py-1 rounded-lg text-[#718096] hover:bg-[#dde3ec] transition-all">Rail</button>
  <button data-nav="overlay" class="nav-choice px-2 py-1 rounded-lg text-[#718096] hover:bg-[#dde3ec] transition-all">Overlay</button>
</div>

<script>
  const choice = localStorage.getItem('nav-style') || 'fab';
  setNavStyle(choice);

  document.querySelectorAll('.nav-choice').forEach(btn => {
    btn.addEventListener('click', () => {
      const style = btn.getAttribute('data-nav') || 'fab';
      localStorage.setItem('nav-style', style);
      setNavStyle(style);
    });
  });

  function setNavStyle(style: string) {
    document.querySelectorAll('.nav-variant').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.nav-choice').forEach(btn => {
      btn.classList.toggle('bg-[#2d3748]', btn.getAttribute('data-nav') === style);
      btn.classList.toggle('text-white', btn.getAttribute('data-nav') === style);
      btn.classList.toggle('text-[#718096]', btn.getAttribute('data-nav') !== style);
    });
    const active = document.getElementById(`nav-${style}`);
    active?.classList.remove('hidden');
  }
</script>
