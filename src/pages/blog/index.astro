---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/translations';
import { getCollection } from 'astro:content';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const prefix = locale === 'en' ? '/en' : '';
---

<Layout title={`${t('nav.blog')} — Nikita Nirinovich`}>
  <main class="min-h-screen bg-[#e8ecf1] pt-24 pb-16 px-8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-[#2d3748] mb-12">{t('nav.blog')}</h1>

      <div class="space-y-6">
        {sortedPosts.map(post => (
          <a href={`${prefix}/blog/${post.id}`} class="block bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow group">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-semibold text-[#2d3748] group-hover:text-[#4a5568] transition-colors">{post.data.title}</h2>
                <p class="text-[#718096] mt-2">{post.data.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {post.data.tags.map(tag => (
                    <span class="text-xs px-2 py-0.5 bg-[#dde3ec] text-[#4a5568] rounded-full">#{tag}</span>
                  ))}
                </div>
              </div>
              <span class="text-sm text-[#718096] whitespace-nowrap">
                {post.data.date.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
