---
// Hero component - Two-column hero with profile image, ID-tag hover card, and custom cursor
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  headline?: string;
  role?: string;
  resumeLabel: string;
  githubLabel: string;
  profileImage?: string;
}

const { 
  name, 
  headline = 'I build websites and manage IT for SMEs',
  role = 'As a full-stack developer',
  resumeLabel, 
  githubLabel, 
  profileImage = '/profile.png' 
} = Astro.props;
---

<header id="hero" class="border-b-2 border-slate-800 min-h-screen flex flex-col">
  <!-- Hero content -->
  <div class="flex-1 grid w-full grid-cols-1 md:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] items-stretch">
    <div class="flex flex-col justify-center gap-6 px-8 py-16 sm:px-16 sm:py-20 lg:pl-24 lg:pr-8">
      <span class="text-xs font-mono uppercase tracking-widest text-accent">{role}</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-heading leading-[1.1] tracking-tight text-white max-w-xl">
        {headline}
      </h1>
      
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/resume.pdf" class="inline-flex items-center justify-center bg-white text-primary-dark px-6 py-3 font-bold uppercase tracking-wider text-sm hover:bg-slate-200 transition-colors">
          {resumeLabel}
        </a>
        <a href="https://github.com/nirinovich" target="_blank" class="inline-flex items-center justify-center border-2 border-slate-800 text-slate-300 px-6 py-3 font-bold uppercase tracking-wider text-sm hover:bg-slate-900 transition-colors gap-2">
          <Icon name="mdi:github" class="w-5 h-5" /> {githubLabel}
        </a>
      </div>
    </div>
    
    <div class="relative flex h-full w-full items-center justify-start pl-4 pr-12 py-12">
      <div class="group relative">
        <div class="relative w-full max-w-sm aspect-[3/4] border-2 border-slate-800 bg-slate-900 p-2 transform rotate-3 group-hover:rotate-0 transition-transform duration-500">
           <img src={profileImage} alt={name} class="w-full h-full object-cover transition-all duration-700" />
        </div>

        <!-- ID tag: slides out of the image's bottom-left corner on hover -->
        <div class="pointer-events-none absolute -bottom-4 left-1/2 z-10 w-max max-w-[16rem] -translate-x-1/2 translate-y-3 border-2 border-slate-800 bg-primary-dark p-3 opacity-0 shadow-[4px_4px_0_rgba(3,103,255,0.25)] transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          <p class="text-base font-bold font-heading text-white tracking-tight">{name}</p>
          <p class="mt-0.5 text-[10px] font-mono uppercase tracking-widest text-accent">{role}</p>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Custom cursor — fully replaces native (fine-pointer devices only)
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (finePointer) {
    const dot = document.createElement('div');
    dot.className = 'custom-cursor-dot';
    const ring = document.createElement('div');
    ring.className = 'custom-cursor-ring';
    document.body.appendChild(dot);
    document.body.appendChild(ring);
    document.documentElement.classList.add('custom-cursor-active');

    let x = 0, y = 0, rx = 0, ry = 0, rafId: number | null = null;
    let visible = false;

    function show() {
      if (!visible) {
        visible = true;
        dot.style.opacity = '1';
        ring.style.opacity = '1';
      }
    }
    function hide() {
      visible = false;
      dot.style.opacity = '0';
      ring.style.opacity = '0';
    }

    document.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      show();
      dot.style.transform = `translate(${x}px, ${y}px)`;
      if (rafId === null) {
        rafId = requestAnimationFrame(() => {
          rafId = null;
          rx += (x - rx) * 0.18;
          ry += (y - ry) * 0.18;
          ring.style.transform = `translate(${rx}px, ${ry}px)`;
        });
      }
    });

    document.addEventListener('pointerleave', hide);

    // Grow ring over interactive elements
    document.addEventListener('pointerover', (e) => {
      const t = (e.target as HTMLElement).closest('a, button, [role="button"]');
      ring.classList.toggle('custom-cursor-ring--active', !!t);
    });
  }
</script>
