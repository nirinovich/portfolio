---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/translations';
import { Icon } from 'astro-icon/components';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en';
const t = useTranslations(locale);
---

<Layout title={`${t('contact.title')} — Nikita Nirinovich`}>
  <main class="min-h-screen bg-primary-dark text-white">
    <section class="border-b-2 border-slate-800">
      <div class="px-8 py-24 sm:px-16 sm:py-32 lg:px-24">
        <h1 class="text-4xl sm:text-5xl font-bold font-heading tracking-tight text-white">{t('contact.title')}</h1>
        <p class="mt-4 max-w-xl text-lg text-slate-400 font-sans">{t('contact.description')}</p>
      </div>
    </section>

    <section>
      <div class="px-8 py-16 sm:px-16 sm:py-24 lg:px-24">
        <div class="max-w-xl">
          <!-- Primary CTA: email -->
          <a
            href="mailto:nikita@nirinovich.com"
            class="group flex items-center gap-5 border-2 border-slate-800 bg-slate-900 p-6 transition-colors hover:border-slate-600 sm:p-8"
          >
            <div class="flex h-14 w-14 shrink-0 items-center justify-center border-2 border-slate-800 bg-primary-dark">
              <Icon name="mdi:email" class="h-7 w-7 text-accent" />
            </div>
            <div class="min-w-0">
              <h2 class="text-xl font-bold font-heading text-white group-hover:text-accent transition-colors">{t('contact.emailCta')}</h2>
              <p class="truncate text-base text-slate-400">nikita@nirinovich.com</p>
            </div>
            <span class="ml-auto shrink-0 text-base font-mono uppercase tracking-widest text-accent">→</span>
          </a>

          <!-- Quiet signal line -->
          <p class="mt-8 text-sm font-mono uppercase tracking-widest text-slate-500">
            {t('contact.availability')} — {t('contact.location')} · {t('contact.responseTime')} · {t('contact.remote')} · FR · EN
          </p>

          <!-- Secondary channels -->
          <div class="mt-12 flex gap-6">
            <a href="https://www.linkedin.com/in/nirinovich/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm font-mono uppercase tracking-widest text-slate-400 transition-colors hover:text-accent">
              <Icon name="mdi:linkedin" class="h-4 w-4" />
              LinkedIn
            </a>
            <a href="https://github.com/nirinovich" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm font-mono uppercase tracking-widest text-slate-400 transition-colors hover:text-accent">
              <Icon name="mdi:github" class="h-4 w-4" />
              GitHub
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
