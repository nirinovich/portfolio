---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/translations';
import { Icon } from 'astro-icon/components';

const locale = (Astro.currentLocale ?? 'en') as 'fr' | 'en';
const t = useTranslations(locale);
---

<Layout title={`${t('contact.title')} — Nikita Nirinovich`}>
  <main class="min-h-screen bg-primary-dark text-white">
    <section class="border-b-2 border-slate-800">
      <div class="px-8 py-16 sm:px-16 sm:py-20 lg:px-24">
        <h1 class="text-4xl sm:text-5xl font-bold font-heading tracking-tight text-white">{t('contact.title')}</h1>
        <p class="mt-4 text-lg text-slate-400 font-sans">{t('contact.description')}</p>
      </div>
    </section>

    <section>
      <div class="px-8 py-12 sm:px-16 sm:py-16 lg:px-24">
        <div class="max-w-3xl">
          <div class="flex flex-col border-2 border-slate-800">
            <a href="mailto:nikita@nirinovich.com" class="group flex items-center gap-5 border-b-2 border-slate-800 p-6 transition-colors hover:bg-slate-900 sm:p-8">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center border-2 border-slate-800 bg-slate-900">
                <Icon name="mdi:email" class="h-6 w-6 text-accent" />
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold font-heading text-white group-hover:text-accent transition-colors">{t('contact.email')}</h3>
                <p class="truncate text-sm text-slate-400">nikita@nirinovich.com</p>
              </div>
              <span class="ml-auto shrink-0 text-[10px] font-mono uppercase tracking-widest text-slate-500 group-hover:text-accent transition-colors">→</span>
            </a>

            <a href="https://www.linkedin.com/in/nirinovich/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-5 border-b-2 border-slate-800 p-6 transition-colors hover:bg-slate-900 sm:p-8">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center border-2 border-slate-800 bg-slate-900">
                <Icon name="mdi:linkedin" class="h-6 w-6 text-accent" />
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold font-heading text-white group-hover:text-accent transition-colors">{t('contact.linkedin')}</h3>
                <p class="truncate text-sm text-slate-400">linkedin.com/in/nirinovich</p>
              </div>
              <span class="ml-auto shrink-0 text-[10px] font-mono uppercase tracking-widest text-slate-500 group-hover:text-accent transition-colors">→</span>
            </a>

            <a href="https://github.com/nirinovich" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-5 p-6 transition-colors hover:bg-slate-900 sm:p-8">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center border-2 border-slate-800 bg-slate-900">
                <Icon name="mdi:github" class="h-6 w-6 text-accent" />
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold font-heading text-white group-hover:text-accent transition-colors">{t('contact.github')}</h3>
                <p class="truncate text-sm text-slate-400">github.com/nirinovich</p>
              </div>
              <span class="ml-auto shrink-0 text-[10px] font-mono uppercase tracking-widest text-slate-500 group-hover:text-accent transition-colors">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
