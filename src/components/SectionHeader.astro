---
// SectionHeader component - Centered section title with accent emphasis and optional link
interface Props {
  title: string;
  emphasis?: string;
  link?: string;
  linkText?: string;
  // Semantic heading level (defaults to a <div> for backwards compatibility)
  headingLevel?: 'h2' | 'h3' | 'h4';
  // Compact vertical rhythm (default false keeps the current py-20)
  compact?: boolean;
  class?: string;
}

const { title, emphasis, link, linkText, headingLevel, compact = false, class: className = '' } = Astro.props;

// Split title to insert emphasis if provided
const titleParts = emphasis ? title.split(emphasis) : [title];
const Tag = headingLevel ?? 'div';
---

<Tag class:list={[
  "mx-auto max-w-xl text-balance px-8 py-20 text-center text-3xl font-bold leading-tight tracking-tight sm:text-4xl font-heading",
  compact && "py-10 sm:py-12",
  className
]}>
  {emphasis ? (
    <Fragment>
      {titleParts[0]}<strong class="text-accent">{emphasis}</strong>{titleParts[1]}
    </Fragment>
  ) : (
    <Fragment set:html={title} />
  )}
  {link && linkText && (
    <div class="mt-4">
      <a href={link} class="mt-2 inline-flex items-center gap-2 bg-accent text-white text-sm font-bold uppercase tracking-wider px-5 py-2.5 hover:bg-accent/80 transition-colors">
        {linkText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  )}
</Tag>
