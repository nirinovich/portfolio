---
interface Props {
  title: string;
  role?: string;
  year: string;
  metric?: string;
  metricLabel?: string;
  outcome?: string;
  tags: string[];
  client?: string;
  image?: string;
  liveUrl?: string;
  repoUrl?: string;
  slug: string;
  locale: string;
}

const { title, role, year, metric, metricLabel, outcome, tags, client, image, liveUrl, repoUrl, slug, locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
---

<a href={`${prefix}/projects/${slug}`} class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-transparent hover:border-accent/20">
  {image && (
    <div class="aspect-video bg-[#f1f5f9] overflow-hidden flex items-center justify-center p-6 md:p-8">
      <img src={image} alt={title} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" />
    </div>
  )}
  <div class="p-5 md:p-6">
    <div class="flex items-center gap-3 mb-2">
      <h3 class="text-lg md:text-xl font-bold text-[#2d3748] group-hover:text-accent transition-colors">{title}</h3>
      {liveUrl && <span class="text-xs px-2 py-0.5 bg-accent text-white rounded-full">Live</span>}
    </div>
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs text-accent font-medium">{year}</span>
      {role && <span class="text-xs text-[#718096]">· {role}</span>}
      {client && <span class="text-xs text-[#718096]">· {client}</span>}
    </div>
    {outcome && <p class="text-sm text-[#4a5568] mb-4 line-clamp-3">{outcome}</p>}
    {metric && metricLabel && (
      <div class="flex items-baseline gap-2 mb-3">
        <span class="text-lg font-bold text-accent">{metric}</span>
        <span class="text-xs text-[#718096]">{metricLabel}</span>
      </div>
    )}
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => <span class="text-xs px-2 py-0.5 bg-accent-light text-accent-dark rounded-full">{tag}</span>)}
    </div>
  </div>
</a>
