---
// CTASection component - Call-to-action section with email link
interface Props {
  message: string;
  emailLabel: string;
  email?: string;
  class?: string;
}

const { 
  message, 
  emailLabel, 
  email = 'nikita@nirinovich.com',
  class: className = '' 
} = Astro.props;
---

<section class:list={[
  "py-32 flex justify-center border-t-2 border-slate-800",
  className
]}>
  <div class="text-center px-8">
    <p class="text-slate-400 font-sans mb-8 text-lg">
      {message}
    </p>
    <a href={`mailto:${email}`} class="inline-flex items-center gap-3 bg-accent text-white px-10 py-5 font-bold uppercase tracking-wider text-base hover:bg-accent-hover transition-colors">
      {emailLabel}
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</section>
