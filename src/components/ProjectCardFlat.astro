---
interface Props {
  title: string;
  role?: string;
  year: string;
  metric?: string;
  metricLabel?: string;
  outcome?: string;
  tags: string[];
  client?: string;
  image?: string;
  liveUrl?: string;
  slug: string;
  locale: string;
}

const { title, role, year, metric, metricLabel, outcome, tags, client, image, liveUrl, slug, locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
---

<a href={`${prefix}/projects/${slug}`} class="group relative block border-b border-gray-200 last:border-b-0">
  <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 p-5 sm:p-8 sm:items-center transition-colors hover:bg-gray-50">
    {image && (
      <div class="relative w-full sm:w-60 shrink-0 aspect-video sm:aspect-[16/10] overflow-hidden bg-gray-100">
        <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105" />
      </div>
    )}
    <div class="flex flex-col gap-2 min-w-0">
      <div class="flex items-center gap-3">
        <h3 class="text-lg md:text-xl font-semibold text-gray-900 tracking-tight">{title}</h3>
        {liveUrl && (
          <span class="text-xs px-2 py-0.5 bg-gray-900 text-white rounded-sm font-medium">Live</span>
        )}
      </div>
      <div class="flex items-center gap-2 text-sm text-gray-500">
        <span>{year}</span>
        {role && <><span>·</span><span>{role}</span></>}
        {client && <><span>·</span><span>{client}</span></>}
      </div>
      {outcome && (
        <p class="text-sm text-gray-600 leading-relaxed line-clamp-2">{outcome}</p>
      )}
      {metric && metricLabel && (
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-base font-semibold text-gray-900">{metric}</span>
          <span class="text-xs text-gray-500">{metricLabel}</span>
        </div>
      )}
      <div class="flex flex-wrap gap-1.5 mt-1">
        {tags.map(tag => (
          <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded-sm">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</a>
