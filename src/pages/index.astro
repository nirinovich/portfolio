---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
  <main class="min-h-screen bg-[#e8ecf1] flex items-center justify-center px-8">
    <div class="max-w-4xl w-full flex flex-col md:flex-row items-center md:items-start gap-12 md:gap-16">
      
      <!-- Profile Image Card -->
      <div class="flex-shrink-0">
        <div class="w-64 h-80 bg-white rounded-2xl shadow-lg overflow-hidden">
          <img 
            src="/Design sans titre (1).png" 
            alt="Nikita Nirinovich" 
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h1 class="text-5xl md:text-6xl font-bold text-[#2d3748] tracking-tight">
          Nikita Nirinovich
        </h1>
        
        <p class="text-xl md:text-2xl text-[#718096] mt-3 font-medium flex items-center gap-2">
          CS Student @
          <a href="https://esti.mg/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg px-3 py-1 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-105 transition-all">
            <img src="/logo-ESTI1-foot.svg" alt="ESTI" class="h-7 inline-block" />
          </a>
        </p>
        
        <p class="text-base md:text-lg text-[#4a5568] mt-6 max-w-lg leading-relaxed">
          À la fois étudiant, développeur web et visionnaire : je vous partage mon parcours dans le monde de l'informatique.
        </p>
        <p class="text-base md:text-lg text-[#4a5568] mt-4 max-w-lg leading-relaxed">
          Ce portfolio abrite mes projets, des mini-jeux et un OS interactif à explorer.
        </p>

        <!-- Navigation Links -->
        <div class="flex items-center justify-between w-full mt-10">
          <nav class="flex items-center gap-8">
            <a href="#work" class="relative text-[#4a5568] hover:text-[#2d3748] transition-colors text-lg after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#2d3748] after:transition-all after:duration-300 hover:after:w-full">
              work
            </a>
            <a href="#projects" class="relative text-[#4a5568] hover:text-[#2d3748] transition-colors text-lg after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#2d3748] after:transition-all after:duration-300 hover:after:w-full">
              projects
            </a>
            <a href="#resume" class="relative text-[#4a5568] hover:text-[#2d3748] transition-colors text-lg after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#2d3748] after:transition-all after:duration-300 hover:after:w-full">
              resume
            </a>
          </nav>

          <!-- Social Icons -->
          <div class="flex items-center gap-5">
            <a href="https://github.com/nirinovich" target="_blank" rel="noopener noreferrer" class="text-[#4a5568] hover:text-[#2d3748] transition-colors">
              <Icon name="mdi:github" class="w-6 h-6" />
            </a>
            <a href="https://www.linkedin.com/in/nirinovich/" target="_blank" rel="noopener noreferrer" class="text-[#4a5568] hover:text-[#2d3748] transition-colors">
              <Icon name="mdi:linkedin" class="w-6 h-6" />
            </a>
            <a href="mailto:nikita@nirinovich.com" class="text-[#4a5568] hover:text-[#2d3748] transition-colors">
              <Icon name="mdi:email" class="w-6 h-6" />
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>
