---
// ProjectCard component - Dark project card with variant support (metrics, narrative, before-after)
interface Props {
  title: string;
  role?: string;
  year: string;
  metric?: string;
  metricLabel?: string;
  outcome?: string;
  before?: string;
  after?: string;
  tags: string[];
  client?: string;
  image?: string;
  liveUrl?: string;
  slug: string;
  locale: string;
  cardVariant: 'metrics' | 'narrative' | 'before-after';
}

const { title, role, year, metric, metricLabel, outcome, before, after, tags, client, image, liveUrl, slug, locale, cardVariant } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
---

<a
  href={`${prefix}/projects/${slug}`}
  class="group flex h-full flex-col overflow-hidden border-2 border-slate-800 bg-primary-dark transition-colors hover:border-slate-600"
>
  <div class="relative aspect-video w-full overflow-hidden bg-slate-900 border-b-2 border-slate-800">
    {image && (
      <img
        src={image}
        alt={title}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-500 group-hover:scale-105 group-hover:opacity-80 filter grayscale group-hover:grayscale-0"
      />
    )}
    <div class="absolute top-4 left-4 bg-accent text-white text-xs font-bold px-2 py-1 uppercase tracking-wider">
      {year}
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-7">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-xl font-bold leading-snug tracking-tight font-heading group-hover:text-accent transition-colors">
        {title}
      </h3>
      {liveUrl && (
        <span class="mt-1 shrink-0 text-[10px] font-mono uppercase tracking-widest text-accent border border-slate-700 px-2 py-1">
          Live
        </span>
      )}
    </div>

    {(role || client) && (
      <p class="text-sm text-slate-500 font-medium">
        {[year, role, client].filter(Boolean).join(' · ')}
      </p>
    )}

    {cardVariant === 'metrics' && metric && metricLabel && (
      <div class="flex items-baseline gap-2 border-y-2 border-slate-800 py-3">
        <span class="text-2xl font-bold text-accent tracking-tight">{metric}</span>
        <span class="text-sm text-slate-400">{metricLabel}</span>
      </div>
    )}

    {cardVariant === 'before-after' && before && after && (
      <div class="grid grid-cols-2 gap-3">
        <div class="border-2 border-slate-800 bg-slate-900/50 p-3">
          <p class="text-[10px] font-mono uppercase tracking-widest text-slate-500 mb-1">Before</p>
          <p class="text-sm text-slate-400">{before}</p>
        </div>
        <div class="border-2 border-slate-800 bg-slate-900/50 p-3">
          <p class="text-[10px] font-mono uppercase tracking-widest text-slate-500 mb-1">After</p>
          <p class="text-sm text-slate-400">{after}</p>
        </div>
      </div>
    )}

    {outcome && (
      <p class="text-sm leading-relaxed text-slate-400 font-sans flex-1">
        {outcome}
      </p>
    )}

    <div class="mt-auto flex flex-wrap gap-2">
      {tags.slice(0, 3).map(tag => (
        <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500 border border-slate-700 px-2 py-1 bg-slate-900">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>
