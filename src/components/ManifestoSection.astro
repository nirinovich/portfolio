---
// ManifestoSection component - Two-column manifesto with heading and body text
interface Props {
  heading: string;
  paragraphs: string[];
  class?: string;
}

const { heading, paragraphs, class: className = '' } = Astro.props;
---

<section class:list={[
  "grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-8 md:gap-16 border-b-2 border-slate-800 px-8 py-12 sm:px-16 sm:py-0",
  className
]}>
  <h2 class="flex text-balance text-3xl font-bold leading-tight tracking-tight sm:-mt-3 sm:py-16 sm:text-4xl md:py-24 font-heading">
    {heading}
  </h2>
  <div class="flex flex-col sm:border-l-2 sm:border-slate-800 sm:py-16 sm:pl-16 md:py-24 md:pl-20 font-sans">
    {paragraphs.map((p, i) => (
      <div class:list={[
        "flex gap-4 py-6 text-base leading-relaxed text-slate-400 sm:text-lg",
        i < paragraphs.length - 1 ? 'border-b border-slate-800/50' : ''
      ]}>
        <span class="text-accent font-mono text-sm mt-1 flex-shrink-0">0{i + 1}</span>
        <p>{p}</p>
      </div>
    ))}
  </div>
</section>
